# Agent key required for autonomous workflows.
# Generate a unique high-entropy value for each environment and never commit it.
SHOPVIVALIZ_AGENT_KEY=replace-with-a-unique-secret

# Legacy aliases are populated from SHOPVIVALIZ_AGENT_KEY by config/agent-keys.php.
# Copy this file to .env, set the real value, then run:
# SHOPVIVALIZ_AGENT_KEY='your-secret' bash scripts/setup-agent-keys.sh

# Email de atendimento que recebe notificações de novos pedidos,
# pagamentos confirmados, etc (ver api/emails/send-order-notification.php)
ADMIN_EMAIL=atendimento@shopvivaliz.com.br

# SMTP usado por scripts/mailer.php para envio de emails transacionais
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=agentes@shopvivaliz.com.br
SMTP_PASS=replace-with-real-smtp-password
EMAIL_FROM=agentes@shopvivaliz.com.br

# --- Webhooks: segredos compartilhados (OBRIGATORIOS) ---
# Sem estes valores os endpoints respondem 503 e nenhum webhook e processado.
# Gere valores unicos e de alta entropia, ex.: openssl rand -hex 32

# InfinitePay. E anexado automaticamente a webhook_url enviada ao gateway
# (includes/infinitepay-gateway.php::svip_webhook_url), entao basta definir aqui.
# Protege contra alguem marcar um pedido como pago sem ter pago.
INFINITEPAY_WEBHOOK_SECRET=replace-with-a-unique-secret

# Olist/Tiny: reusa OLIST_WEBHOOK_TOKEN, que ja e usado por
# api/webhooks/order-status-update.php — nao ha segredo novo a gerenciar.
# Configure a URL de callback no painel da Olist como:
#   https://shopvivaliz.com.br/api/olist/webhook-receiver.php?event=<evento>&token=<valor>
# ou envie o header X-Webhook-Token / Authorization: Bearer <valor>.
# Obs.: Apache aqui nao repassa Authorization via $_SERVER; os endpoints usam
# getallheaders() como fallback, mas a query string e o caminho mais seguro.
OLIST_WEBHOOK_TOKEN=replace-with-a-unique-secret

# Blog: publicacao automatica agendada (ver api/blog/publish-scheduled.php e
# .github/workflows/blog-publish-scheduled.yml). Mesmo valor deve estar
# configurado no GitHub Secret BLOG_PUBLISH_TOKEN.
BLOG_PUBLISH_TOKEN=replace-with-a-unique-secret

# Melhor Envio: valida assinatura HMAC do webhook (ver api/melhorenvio/webhook.php).
MELHORENVIO_WEBHOOK_SECRET=replace-with-a-unique-secret

# Mercado Pago ja valida assinatura HMAC (X-Signature) — nao precisa de token extra,
# mas MERCADOPAGO_WEBHOOK_SECRET e MERCADOPAGO_ACCESS_TOKEN precisam estar definidos.

# --- Google Analytics 4 & Google Ads Tracking (FASE 1 & 2) ---
# Obrigatorio para server-side tracking de compras (Measurement Protocol).
# Se nao configurado, tracking client-side continua funcionando, mas conversoes
# nao serao registradas no GA4 server-side apos pagamento aprovado.

# GA4 Measurement ID: Obter em Google Analytics 4 > Admin > Data Streams > Seu stream Web > ID
# Formato: G-XXXXXXXXX (ex: G-1H55K1TZ5D)
GA4_ID=G-XXXXXXXXXX

# GA4 API Secret: Obter em Google Analytics 4 > Admin > Data API > Create Secret
# Deixe vazio no exemplo; configure o valor real apenas no ambiente seguro.
GA4_SECRET=

# Google Ads Conversion Tracking (opcional, mas recomendado)
# Conversion ID: Obter em Google Ads > Tools & Settings > Conversions > Selecione "Purchase"
# Formato: numero (ex: 123456789 ou AW-123456789)
GOOGLE_ADS_CONVERSION_ID=replace-with-conversion-id

# Conversion Label: Label gerado pelo Google Ads para a conversao de Purchase
# Formato: alphanumerico com hifen (ex: abc-123-xyz)
GOOGLE_ADS_CONVERSION_LABEL=replace-with-conversion-label

# (Opcional) Coluna adicional para tracking de eventos customizados
# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXXXX
# GOOGLE_SITE_VERIFICATION=seu-codigo-verificacao

# --- AI Image Studio (admin/ai-image-studio/) ---
# Geração de imagens de produto via OpenAI, Google Imagen ou Claude
# (Claude só reescreve/otimiza o prompt; a imagem final sai do OpenAI ou do
# Google). Nenhuma dessas chaves tem valor real neste arquivo — configure em
# .env / shared/.env, nunca aqui. Sem elas, o provedor correspondente
# simplesmente retorna erro tratado (ver AiServices.php), sem derrubar o site.

# OpenAI: Obter em https://platform.openai.com/api-keys
OPENAI_API_KEY=replace-with-openai-api-key
# Modelo de imagem (opcional, default: gpt-image-1)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_API_KEYS=

# Google (via Gemini API, autenticação por API key simples):
# Obter em https://aistudio.google.com/apikey
GOOGLE_IMAGEN_API_KEY=replace-with-google-imagen-api-key
# Modelo multimodal (imagem + texto -> imagem editada), opcional,
# default: gemini-2.5-flash-image. NÃO trocar por um modelo Imagen clássico
# (imagen-4.x) — esses são text-to-image puro e não aceitam a foto real do
# produto como entrada, quebrando a fidelidade exigida pelo negócio.
GOOGLE_IMAGEN_MODEL=gemini-2.5-flash-image
GOOGLE_IMAGEN_API_KEYS=
# Usado apenas se futuramente migrar para o endpoint Vertex AI (OAuth de
# service account) em vez da Gemini API — não usado na integração atual.
GOOGLE_IMAGEN_PROJECT_ID=
GOOGLE_IMAGEN_LOCATION=us-central1

# Anthropic Claude: Obter em https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=replace-with-claude-api-key
# Modelo (opcional, default: claude-3-7-sonnet-20250219)
CLAUDE_MODEL=claude-3-7-sonnet-20250219
CLAUDE_API_KEYS=

# OpenRouter pode ser usado como fallback OpenAI-compatible.
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=
OPENROUTER_HTTP_REFERER=https://shopvivaliz.com.br
OPENROUTER_APP_TITLE=ShopVivaliz

# Qrope (OpenAI-compatible, se configurado no ambiente).
QROPE_API_KEY=
QROPE_API_KEYS=
QROPE_API_BASE_URL=
QROPE_IMAGE_MODEL=

# Groq (OpenAI-compatible; qrope was treated as an alias in the code)
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_IMAGE_MODEL=openai/gpt-oss-20b

# --- Otimização de Cadastro / SEO-GEO (admin/catalog-optimization/) ---
# Reescreve título/descrição/bullets/SEO de produtos por canal de venda
# (Mercado Livre, Shopee, Amazon, TikTok Shop, site próprio, ERP) via
# OpenAI, Google Gemini ou Claude. Módulo isolado do AI Image Studio, mas
# reaproveita OPENAI_API_KEY e CLAUDE_API_KEY já definidas acima (mesma
# conta/chave nas duas integrações). Preço e estoque NUNCA são lidos nem
# escritos por este módulo. Sem a chave do provedor escolhido, a chamada
# falha com erro claro — não há simulação de sucesso.

# Google Gemini (texto) — pode reusar a mesma chave de GOOGLE_IMAGEN_API_KEY
# (ambas são chaves da Gemini API / Google AI Studio), mas fica em variável
# própria para manter os dois módulos completamente independentes.
# Obter em https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=replace-with-google-gemini-api-key

# Modelos de texto (opcionais, sobrescrevem os defaults do código):
OPENAI_TEXT_MODEL=gpt-4.1
GOOGLE_GEMINI_MODEL=gemini-2.5-pro
CLAUDE_TEXT_MODEL=claude-sonnet-4-20250514

# Timeout das chamadas de IA em segundos (mínimo 60, aplicado automaticamente
# mesmo se um valor menor for configurado aqui).
CATALOG_AI_HTTP_TIMEOUT_SECONDS=90

# --- Publicação real de catálogo nos marketplaces ---
# Nunca coloque valores reais neste arquivo versionado. Configure-os no GitHub
# Secrets/environment protegido e em /home/ubuntu/shopvivaliz-deploy/shared/.env.
# config/constants.php carrega runtime-secrets.php, .env da release e shared/.env.

# Mercado Livre
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_SELLER_ID=

# Shopee Open API
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_TOKEN_FILE=/home/ubuntu/shopvivaliz-deploy/shared/shopee-tokens.json

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_ID=
TIKTOK_TOKEN_FILE=/home/ubuntu/shopvivaliz-deploy/shared/tiktok-tokens.json

# Amazon Selling Partner API
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_ACCOUNT_ID=
AMAZON_MARKETPLACE_ID=
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_SP_API_REGION=us-east-1

# Olist/Tiny — textos usam OAuth v3; imagens usam a API v2 quando disponível.
OLIST_ACCESS_TOKEN=
OLIST_REFRESH_TOKEN=
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_API_KEY=
TINY_ACCESS_TOKEN=
TINY_REFRESH_TOKEN=
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
TOKEN_API_OLIST=
