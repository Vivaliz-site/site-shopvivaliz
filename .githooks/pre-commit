#!/usr/bin/env bash
set -Eeuo pipefail
branch="$(git branch --show-current)"
case "$branch" in main|master) echo 'BLOCKED: commits directly on protected branch are forbidden.' >&2; exit 40;; esac
root="$(git rev-parse --show-toplevel)"
"$root/scripts/repository-governance-validate.sh" pre-commit
python3 "$root/scripts/git_autonomous_agent.py" hook-pre-commit
