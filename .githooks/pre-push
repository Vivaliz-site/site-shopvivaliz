#!/usr/bin/env bash
set -Eeuo pipefail
root="$(git rev-parse --show-toplevel)"
if [ -n "$(git -C "$root" status --porcelain=v1)" ]; then echo 'BLOCKED: working tree must be clean before push.' >&2; exit 41; fi
zero_sha="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main|refs/heads/master) echo 'BLOCKED: direct push to protected branch is forbidden.' >&2; exit 42;; esac
  if [ "$remote_sha" != "$zero_sha" ] && [ "$local_sha" != "$zero_sha" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then echo 'BLOCKED: non-fast-forward push is forbidden.' >&2; exit 43; fi
  fi
done
"$root/scripts/repository-governance-validate.sh" pre-push
