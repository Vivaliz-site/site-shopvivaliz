name: AI Credential Presence Audit

on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/ai-credential-presence-audit.yml'
      - 'config/constants.php'
      - '.ai/llm-provider.js'
      - 'scripts/materialize-runtime-secrets.php'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ai-credential-presence-audit
  cancel-in-progress: true

jobs:
  audit:
    name: Auditar contas OpenAI e Gemini sem revelar valores
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: production
    env:
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      OPENAI_API_KEY_2: ${{ secrets.OPENAI_API_KEY_2 }}
      OPENAI_API_KEY_SECONDARY: ${{ secrets.OPENAI_API_KEY_SECONDARY }}
      OPENAI_API_KEY_BACKUP: ${{ secrets.OPENAI_API_KEY_BACKUP }}
      OPENAI_API_KEY_ALT: ${{ secrets.OPENAI_API_KEY_ALT }}
      OPENAI_KEY: ${{ secrets.OPENAI_KEY }}
      OPENAI_KEY_2: ${{ secrets.OPENAI_KEY_2 }}
      GPT_API_KEY: ${{ secrets.GPT_API_KEY }}
      GPT_API_KEY_2: ${{ secrets.GPT_API_KEY_2 }}
      GPT_API_KEY_SECONDARY: ${{ secrets.GPT_API_KEY_SECONDARY }}
      CHATGPT_API_KEY: ${{ secrets.CHATGPT_API_KEY }}
      OPENAI_PROJECT_ID: ${{ secrets.OPENAI_PROJECT_ID }}
      OPENAI_PROJECT_ID_2: ${{ secrets.OPENAI_PROJECT_ID_2 }}
      OPENAI_ORG_ID: ${{ secrets.OPENAI_ORG_ID }}
      OPENAI_ORG_ID_2: ${{ secrets.OPENAI_ORG_ID_2 }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      GEMINI_API_KEY_2: ${{ secrets.GEMINI_API_KEY_2 }}
      GEMINI_API_KEY_SECONDARY: ${{ secrets.GEMINI_API_KEY_SECONDARY }}
      GEMINI_API_KEY_BACKUP: ${{ secrets.GEMINI_API_KEY_BACKUP }}
      GEMINI_KEY: ${{ secrets.GEMINI_KEY }}
      GEMINI_KEY_2: ${{ secrets.GEMINI_KEY_2 }}
      GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
      GOOGLE_API_KEY_2: ${{ secrets.GOOGLE_API_KEY_2 }}
      GOOGLE_GEMINI_API_KEY: ${{ secrets.GOOGLE_GEMINI_API_KEY }}
      GOOGLE_IMAGEN_API_KEY: ${{ secrets.GOOGLE_IMAGEN_API_KEY }}

    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Audit candidate GitHub secret aliases
        shell: bash
        run: |
          set -Eeuo pipefail
          python3 - <<'PY' > github-ai-secret-presence.json
          import json
          import os

          groups = {
              'openai': [
                  'OPENAI_API_KEY', 'OPENAI_API_KEY_2', 'OPENAI_API_KEY_SECONDARY',
                  'OPENAI_API_KEY_BACKUP', 'OPENAI_API_KEY_ALT', 'OPENAI_KEY',
                  'OPENAI_KEY_2', 'GPT_API_KEY', 'GPT_API_KEY_2',
                  'GPT_API_KEY_SECONDARY', 'CHATGPT_API_KEY',
              ],
              'gemini': [
                  'GEMINI_API_KEY', 'GEMINI_API_KEY_2', 'GEMINI_API_KEY_SECONDARY',
                  'GEMINI_API_KEY_BACKUP', 'GEMINI_KEY', 'GEMINI_KEY_2',
                  'GOOGLE_API_KEY', 'GOOGLE_API_KEY_2', 'GOOGLE_GEMINI_API_KEY',
                  'GOOGLE_IMAGEN_API_KEY',
              ],
              'openai_metadata': [
                  'OPENAI_PROJECT_ID', 'OPENAI_PROJECT_ID_2', 'OPENAI_ORG_ID', 'OPENAI_ORG_ID_2',
              ],
          }
          result = {}
          for group, names in groups.items():
              values = {name: os.getenv(name, '').strip() for name in names}
              result[group] = {
                  'aliases': {name: bool(value) for name, value in values.items()},
                  'distinct_nonempty_values': len({value for value in values.values() if value}),
              }
          print(json.dumps(result, sort_keys=True, indent=2))
          PY
          cat github-ai-secret-presence.json

      - name: Configure verified SSH host
        shell: bash
        env:
          PRIMARY_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
          LEGACY_KEY: ${{ secrets.ORACLE_VM_SSH_KEY }}
          PRIMARY_HOSTS: ${{ secrets.SHOPVIVALIZ_VM_KNOWN_HOSTS }}
          LEGACY_HOSTS: ${{ secrets.ORACLE_VM_KNOWN_HOSTS }}
        run: |
          set -Eeuo pipefail
          key="${PRIMARY_KEY:-${LEGACY_KEY:-}}"
          known_hosts="${PRIMARY_HOSTS:-${LEGACY_HOSTS:-}}"
          test -n "$key" || { echo '::error::SSH key missing'; exit 1; }
          test -n "$known_hosts" || { echo '::error::known_hosts missing'; exit 1; }
          install -m 700 -d "$HOME/.ssh"
          printf '%s\n' "$key" > "$HOME/.ssh/id_rsa"
          printf '%s\n' "$known_hosts" > "$HOME/.ssh/known_hosts"
          chmod 600 "$HOME/.ssh/id_rsa" "$HOME/.ssh/known_hosts"

      - name: Audit production env, runtime secrets and constants
        shell: bash
        run: |
          set -Eeuo pipefail
          ssh -o BatchMode=yes -o StrictHostKeyChecking=yes \
            -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
            -i "$HOME/.ssh/id_rsa" ubuntu@137.131.156.17 'bash -s' \
            > production-ai-credential-presence.json <<'REMOTE'
          set -Eeuo pipefail
          cd /home/ubuntu/shopvivaliz-deploy/current
          python3 - <<'PY'
          import json
          import re
          from pathlib import Path

          paths = [
              Path('/home/ubuntu/shopvivaliz-deploy/shared/.env'),
              Path('/home/ubuntu/shopvivaliz-deploy/current/.env'),
          ]
          result = {'env_files': {}}
          pattern = re.compile(r'^(OPENAI|GPT|CHATGPT|GEMINI|GOOGLE)[A-Z0-9_]*$')
          for path in paths:
              state = {
                  'exists': path.is_file(),
                  'readable': False,
                  'keys': {},
                  'openai_distinct_api_keys': 0,
                  'gemini_distinct_api_keys': 0,
                  'safe_equivalence': {},
              }
              discovered = {}
              if path.is_file():
                  try:
                      for raw in path.read_text(encoding='utf-8').splitlines():
                          text = raw.strip()
                          if not text or text.startswith('#') or '=' not in text:
                              continue
                          if text.startswith('export '):
                              text = text[7:].strip()
                          key, value = text.split('=', 1)
                          key = key.strip()
                          value = value.strip().strip('"\'')
                          if pattern.match(key):
                              discovered[key] = value
                              state['keys'][key] = bool(value)
                      state['readable'] = True
                  except OSError:
                      pass
              openai_values = {
                  value for key, value in discovered.items()
                  if value and 'KEY' in key and (
                      key.startswith('OPENAI') or key.startswith('GPT') or key.startswith('CHATGPT')
                  )
              }
              gemini_values = {
                  value for key, value in discovered.items()
                  if value and 'KEY' in key and (
                      key.startswith('GEMINI') or key.startswith('GOOGLE_GEMINI')
                      or key.startswith('GOOGLE_IMAGEN') or key.startswith('GOOGLE_API_KEY')
                  )
              }
              state['openai_distinct_api_keys'] = len(openai_values)
              state['gemini_distinct_api_keys'] = len(gemini_values)
              pairs = [
                  ('GEMINI_API_KEY', 'GOOGLE_GEMINI_API_KEY'),
                  ('GEMINI_API_KEY', 'GOOGLE_IMAGEN_API_KEY'),
                  ('GOOGLE_GEMINI_API_KEY', 'GOOGLE_IMAGEN_API_KEY'),
              ]
              for left, right in pairs:
                  left_value = discovered.get(left, '')
                  right_value = discovered.get(right, '')
                  state['safe_equivalence'][left + '_equals_' + right] = bool(
                      left_value and right_value and left_value == right_value
                  )
              result['env_files'][str(path)] = state
          print(json.dumps(result, sort_keys=True))
          PY
          php -r '
          require "config/constants.php";
          $names = [
            "OPENAI_API_KEY", "OPENAI_API_KEY_2", "OPENAI_API_KEY_SECONDARY", "OPENAI_API_KEY_BACKUP", "OPENAI_API_KEY_ALT",
            "OPENAI_KEY", "OPENAI_KEY_2", "GPT_API_KEY", "GPT_API_KEY_2", "GPT_API_KEY_SECONDARY", "CHATGPT_API_KEY",
            "OPENAI_PROJECT_ID", "OPENAI_PROJECT_ID_2", "OPENAI_ORG_ID", "OPENAI_ORG_ID_2",
            "GEMINI_API_KEY", "GEMINI_API_KEY_2", "GEMINI_API_KEY_SECONDARY", "GEMINI_API_KEY_BACKUP", "GEMINI_KEY", "GEMINI_KEY_2",
            "GOOGLE_API_KEY", "GOOGLE_API_KEY_2", "GOOGLE_GEMINI_API_KEY", "GOOGLE_IMAGEN_API_KEY"
          ];
          $state = [];
          foreach ($names as $name) $state[$name] = trim((string)getenv($name)) !== "";
          echo json_encode(["constants_loader" => $state], JSON_UNESCAPED_SLASHES), PHP_EOL;
          '
          php -r '
          $path = "/home/ubuntu/shopvivaliz-deploy/shared/runtime-secrets.php";
          $keys = [];
          if (is_file($path) && is_readable($path)) {
            $data = require $path;
            if (is_array($data)) {
              foreach (array_keys($data) as $key) {
                $name = (string)$key;
                if (preg_match("/^(OPENAI|GPT|CHATGPT|GEMINI|GOOGLE)[A-Z0-9_]*$/", $name)) $keys[] = $name;
              }
            }
          }
          sort($keys);
          echo json_encode(["runtime_secrets" => ["exists" => is_file($path), "readable" => is_readable($path), "keys" => $keys]], JSON_UNESCAPED_SLASHES), PHP_EOL;
          '
          REMOTE
          cat production-ai-credential-presence.json

      - name: Run real catalog optimization and image generation in production staging
        shell: bash
        run: |
          set -Eeuo pipefail
          ssh -o BatchMode=yes -o StrictHostKeyChecking=yes \
            -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
            -i "$HOME/.ssh/id_rsa" ubuntu@137.131.156.17 'bash -s' \
            > production-ai-real-smoke.json <<'REMOTE'
          set -Eeuo pipefail
          cd /home/ubuntu/shopvivaliz-deploy/current
          php <<'PHP'
          <?php
          declare(strict_types=1);

          require 'admin/catalog-optimization/api/optimize_catalog.php';
          require 'admin/ai-image-studio/process_item.php';

          $db = catalog_ai_db();
          if (!$db instanceof PDO) {
              throw new RuntimeException('database_unavailable');
          }

          $productId = 0;
          $rows = $db->query('SELECT id FROM products ORDER BY id DESC LIMIT 250');
          $candidateIds = $rows ? $rows->fetchAll(PDO::FETCH_COLUMN) : [];
          foreach ($candidateIds as $candidateId) {
              $candidateId = (int)$candidateId;
              $product = ai_studio_fetch_product($db, $candidateId);
              if (!is_array($product) || trim((string)($product['image_ref'] ?? '')) === '') {
                  continue;
              }
              $resolved = null;
              try {
                  $resolved = ai_studio_resolve_base_image((string)$product['image_ref'], getcwd(), $candidateId);
                  $productId = $candidateId;
                  break;
              } catch (Throwable) {
                  continue;
              } finally {
                  if (is_string($resolved) && str_starts_with($resolved, AI_STUDIO_BASE_IMAGE_TMP_DIR) && is_file($resolved)) {
                      @unlink($resolved);
                  }
              }
          }
          if ($productId <= 0) {
              throw new RuntimeException('no_product_with_valid_real_image');
          }

          $catalog = ai_catalog_process_item($db, $productId, 'site', 'openai');
          if (($catalog['success'] ?? false) !== true) {
              throw new RuntimeException('catalog_real_test_failed: ' . CatalogAiHttpClient::safeMessage((string)($catalog['error'] ?? 'unknown')));
          }

          $image = ai_studio_process_item($db, $productId, 'openai', ['white'], null, 'site');
          if (($image['success'] ?? false) !== true) {
              $error = (string)($image['error'] ?? ($image['results'][0]['error'] ?? 'unknown'));
              $error = preg_replace('/\bsk-[A-Za-z0-9_\-]{12,}\b/', '[chave-oculta]', $error) ?? $error;
              throw new RuntimeException('image_real_test_failed: ' . substr($error, 0, 800));
          }

          $imageRow = $image['results'][0] ?? [];
          echo json_encode([
              'success' => true,
              'product_id' => $productId,
              'catalog' => [
                  'staging_id' => (int)($catalog['staging_id'] ?? 0),
                  'quality_score' => (int)($catalog['quality_score'] ?? 0),
              ],
              'image' => [
                  'staging_id' => (int)($imageRow['staging_id'] ?? 0),
                  'image_type' => (string)($imageRow['image_type'] ?? ''),
                  'status' => (string)($imageRow['status'] ?? ''),
                  'width' => (int)($imageRow['quality']['width'] ?? 0),
                  'height' => (int)($imageRow['quality']['height'] ?? 0),
              ],
          ], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), PHP_EOL;
          PHP
          REMOTE
          cat production-ai-real-smoke.json

      - name: Upload redacted presence evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ai-credential-presence-${{ github.run_id }}
          path: |
            github-ai-secret-presence.json
            production-ai-credential-presence.json
            production-ai-real-smoke.json
          if-no-files-found: warn
          retention-days: 7

      - name: Remove SSH material
        if: always()
        run: rm -f "$HOME/.ssh/id_rsa" "$HOME/.ssh/known_hosts"
