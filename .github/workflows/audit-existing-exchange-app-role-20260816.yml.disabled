name: Audit existing Exchange app role 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/audit-existing-exchange-app-role-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  audit:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - name: Configure VM SSH key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Audit current app Exchange assignments
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          cd /home/ubuntu/mei-mg-email
          .venv/bin/python - <<'PY'
          from dotenv import load_dotenv
          load_dotenv('.env', override=True)
          import os,json,urllib.request,urllib.parse,urllib.error
          from app.email_provider import MicrosoftGraphEmailProvider
          token=MicrosoftGraphEmailProvider()._get_access_token()
          h={'Authorization':'Bearer '+token,'Accept':'application/json'}
          def get(url):
              req=urllib.request.Request(url,headers=h)
              try:
                  with urllib.request.urlopen(req,timeout=30) as r: return json.load(r)
              except urllib.error.HTTPError as e:
                  print('HTTP_ERROR='+str(e.code)+' '+e.read().decode('utf-8','replace')[:1200]); return None
          client=os.environ['MICROSOFT_GRAPH_CLIENT_ID']
          filt=urllib.parse.quote("appId eq '"+client+"'")
          me=get('https://graph.microsoft.com/v1.0/servicePrincipals?$filter='+filt+'&$select=id,appId,displayName')
          print('CLIENT_SP='+json.dumps(me,ensure_ascii=False))
          if me and me.get('value'):
              sid=me['value'][0]['id']
              assignments=get(f'https://graph.microsoft.com/v1.0/servicePrincipals/{sid}/appRoleAssignments?$select=id,appRoleId,resourceId,resourceDisplayName,principalId&$top=999')
              print('APP_ROLE_ASSIGNMENTS='+json.dumps(assignments,ensure_ascii=False))
          exf=urllib.parse.quote("appId eq '00000002-0000-0ff1-ce00-000000000000'")
          ex=get('https://graph.microsoft.com/v1.0/servicePrincipals?$filter='+exf+'&$select=id,appId,displayName,appRoles')
          print('EXCHANGE_RESOURCE_PRESENT='+str(bool(ex and ex.get('value'))).lower())
          if ex and ex.get('value'):
              for role in ex['value'][0].get('appRoles',[]):
                  if role.get('value')=='Exchange.ManageAsApp' or role.get('id')=='dc50a0fb-09a3-484d-be87-e023b12c6440':
                      print('EXCHANGE_MANAGE_ROLE='+json.dumps(role,ensure_ascii=False,sort_keys=True))
          PY
          EOF
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
