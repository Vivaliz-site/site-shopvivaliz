name: Deploy Casa dos Dados daily discovery source
# on:
#   push:
#     branches: [main]
#     paths: ['.github/workflows/deploy-casa-dos-dados-daily-source.yml']
#   workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: deploy-casa-dos-dados-daily-source
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey

      - name: Sync Casa dos Dados key from GitHub secret when available
        env:
          CDD_KEY: ${{ secrets.CASA_DOS_DADOS_API_KEY }}
        run: |
          if [ -z "$CDD_KEY" ]; then
            echo CASA_DOS_DADOS_GITHUB_SECRET_CONFIGURED=false
            exit 0
          fi
          umask 077
          printf '%s' "$CDD_KEY" > /tmp/casa-dos-dados.key
          scp -q -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i ~/.ssh/vmkey /tmp/casa-dos-dados.key ubuntu@137.131.156.17:/tmp/casa-dos-dados.key
          rm -f /tmp/casa-dos-dados.key
          ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          chmod 600 /tmp/casa-dos-dados.key
          cd /home/ubuntu/mei-mg-email
          .venv/bin/python - <<'PY'
          from pathlib import Path
          env_path=Path('/home/ubuntu/mei-mg-email/.env')
          key_path=Path('/tmp/casa-dos-dados.key')
          secret=key_path.read_text(encoding='utf-8').strip()
          if not secret:
              raise SystemExit('empty Casa dos Dados key')
          lines=env_path.read_text(encoding='utf-8').splitlines() if env_path.exists() else []
          out=[]
          replaced=False
          for line in lines:
              if line.startswith('CASA_DOS_DADOS_API_KEY='):
                  out.append('CASA_DOS_DADOS_API_KEY='+secret)
                  replaced=True
              else:
                  out.append(line)
          if not replaced:
              out.append('CASA_DOS_DADOS_API_KEY='+secret)
          env_path.write_text('\n'.join(out).rstrip()+'\n',encoding='utf-8')
          env_path.chmod(0o600)
          PY
          rm -f /tmp/casa-dos-dados.key
          EOF
          echo CASA_DOS_DADOS_GITHUB_SECRET_CONFIGURED=true

      - name: Deploy daily source without touching bulk email worker
        run: |
          timeout 420s ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          ROOT=/home/ubuntu/mei-mg-email
          EXPECTED_PRIVATE_SHA=632fab3c10cf73b14adf56fdcce28b05479c3842
          cd "$ROOT"

          # Daily data ingestion is independent from sending. Never start the worker here.
          test "$(sudo systemctl is-active mei-mg-email-worker.service || true)" = inactive
          timeout 40s git fetch --quiet origin main
          actual=$(git rev-parse origin/main)
          echo ORIGIN_MAIN="$actual"
          test "$actual" = "$EXPECTED_PRIVATE_SHA"

          stamp=$(date +%Y%m%d-%H%M%S)
          backup="$ROOT/backups/casa-dos-dados-daily-$stamp"
          mkdir -p "$backup/scripts"
          for f in scripts/ingest_casa_dos_dados_daily.py scripts/sincronizar_base_diaria.py; do
            if [ -e "$f" ]; then cp -a "$f" "$backup/$f"; fi
            tmp=$(mktemp)
            git show "$EXPECTED_PRIVATE_SHA:$f" > "$tmp"
            install -m 750 "$tmp" "$ROOT/$f"
            rm -f "$tmp"
          done
          .venv/bin/python -m py_compile scripts/ingest_casa_dos_dados_daily.py scripts/sincronizar_base_diaria.py

          # Configure only non-secret selector/tuning values.
          .venv/bin/python - <<'PY'
          from pathlib import Path
          path=Path('/home/ubuntu/mei-mg-email/.env')
          text=path.read_text(encoding='utf-8') if path.exists() else ''
          updates={
              'CNPJ_DAILY_SOURCE':'casadosdados',
              'CNPJ_DAILY_LOOKBACK_DAYS':'3',
              'CASA_DOS_DADOS_PAGE_SIZE':'100',
              'CASA_DOS_DADOS_MAX_PAGES':'500',
              'CASA_DOS_DADOS_TIMEOUT_SECONDS':'45',
              'CNPJ_DAILY_TIMEZONE':'America/Sao_Paulo',
          }
          lines=text.splitlines()
          seen=set()
          out=[]
          for line in lines:
              key=line.split('=',1)[0].strip() if '=' in line and not line.lstrip().startswith('#') else None
              if key in updates:
                  out.append(f'{key}={updates[key]}')
                  seen.add(key)
              else:
                  out.append(line)
          for key,value in updates.items():
              if key not in seen:
                  out.append(f'{key}={value}')
          path.write_text('\n'.join(out).rstrip()+'\n',encoding='utf-8')
          path.chmod(0o600)
          PY

          if grep -Eq '^CASA_DOS_DADOS_API_KEY=.+$' .env; then
            echo CASA_DOS_DADOS_KEY_PRESENT=true
          else
            echo CASA_DOS_DADOS_KEY_PRESENT=false
          fi

          # Recover audit rows left as running only when the sync service is not active.
          test "$(sudo systemctl is-active mei-mg-base-sync.service || true)" != active
          .venv/bin/python - <<'PY'
          from dotenv import load_dotenv
          load_dotenv('/home/ubuntu/mei-mg-email/.env',override=True)
          import os,psycopg
          with psycopg.connect(os.environ['DATABASE_URL']) as conn:
              with conn.cursor() as cur:
                  cur.execute("""
                    update mei_email.base_sync_runs
                       set status='failed', finished_at=now(),
                           error=coalesce(error,'interrupted_before_audit_completion'),
                           details=details || '{"recovered_stale_running":true}'::jsonb
                     where source_name='casa_dos_dados_v5' and status='running'
                  """)
                  print('RECOVERED_RUNNING_ROWS='+str(max(cur.rowcount,0)))
              conn.commit()
          PY

          sudo systemctl reset-failed mei-mg-base-sync.service || true
          set +e
          timeout 180s sudo systemctl start mei-mg-base-sync.service
          sync_rc=$?
          set -e
          echo BASE_SYNC_SYSTEMCTL_RC=$sync_rc

          .venv/bin/python - <<'PY'
          from dotenv import load_dotenv
          load_dotenv('/home/ubuntu/mei-mg-email/.env',override=True)
          import json,os,psycopg
          from psycopg.rows import dict_row
          with psycopg.connect(os.environ['DATABASE_URL'],row_factory=dict_row,connect_timeout=10) as conn:
              with conn.cursor() as cur:
                  cur.execute("""
                    select id,source_name,status,started_at,finished_at,rows_before,rows_after,rows_added,error,details
                      from mei_email.base_sync_runs
                     order by id desc limit 1
                  """)
                  row=dict(cur.fetchone())
          print('LATEST_SYNC='+json.dumps(row,default=str,ensure_ascii=False))
          assert row['source_name']=='casa_dos_dados_v5', row
          assert row['status'] in {'failed','success'}, row
          if row['status']=='failed':
              assert (row.get('details') or {}).get('missing_secret')=='CASA_DOS_DADOS_API_KEY', row
          else:
              assert row.get('finished_at') is not None, row
          PY

          test "$(sudo systemctl is-enabled mei-mg-base-sync.timer)" = enabled
          test "$(sudo systemctl is-active mei-mg-base-sync.timer)" = active
          test "$(sudo systemctl is-active mei-mg-email-worker.service || true)" = inactive
          sudo systemctl reset-failed mei-mg-base-sync.service || true
          sudo systemctl list-timers mei-mg-base-sync.timer --all --no-pager
          echo BACKUP="$backup"
          echo DAILY_SOURCE_DEPLOYED_WORKER_INACTIVE
          EOF
      - name: Cleanup
        if: always()
        run: |
          rm -f ~/.ssh/vmkey /tmp/casa-dos-dados.key
