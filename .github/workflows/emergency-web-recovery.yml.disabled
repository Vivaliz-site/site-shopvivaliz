name: Emergency Web Recovery

on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/emergency-web-recovery.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: emergency-web-recovery
  cancel-in-progress: false

jobs:
  recover-web:
    name: Recover Oracle web stack
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Configure verified SSH host
        shell: bash
        env:
          ORACLE_VM_SSH_KEY: ${{ secrets.ORACLE_VM_SSH_KEY }}
          ORACLE_VM_KNOWN_HOSTS: ${{ secrets.ORACLE_VM_KNOWN_HOSTS }}
        run: |
          set -euo pipefail
          test -n "${ORACLE_VM_SSH_KEY:-}"
          test -n "${ORACLE_VM_KNOWN_HOSTS:-}"
          install -d -m 700 "$HOME/.ssh"
          printf '%s\n' "$ORACLE_VM_SSH_KEY" > "$HOME/.ssh/id_rsa"
          chmod 600 "$HOME/.ssh/id_rsa"
          printf '%s\n' "$ORACLE_VM_KNOWN_HOSTS" > "$HOME/.ssh/known_hosts"
          chmod 600 "$HOME/.ssh/known_hosts"

      - name: Diagnose and restart web services
        shell: bash
        run: |
          set -euo pipefail
          ssh \
            -o BatchMode=yes \
            -o StrictHostKeyChecking=yes \
            -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
            -i "$HOME/.ssh/id_rsa" \
            ubuntu@137.131.156.17 \
            'bash -s' <<'REMOTE'
          set -euo pipefail
          echo '=== uptime ==='
          uptime || true
          echo '=== memory ==='
          free -h || true
          echo '=== disk ==='
          df -h / /home/ubuntu || true
          echo '=== apache status before ==='
          sudo systemctl --no-pager --full status apache2 | tail -n 40 || true
          echo '=== recent apache errors ==='
          sudo journalctl -u apache2 --since '-20 min' --no-pager | tail -n 120 || true

          php_fpm_units="$(systemctl list-unit-files --type=service --no-legend 'php*-fpm.service' 2>/dev/null | awk '{print $1}' | tr '\n' ' ')"
          if [[ -n "$php_fpm_units" ]]; then
            for unit in $php_fpm_units; do
              if systemctl is-active --quiet "$unit"; then
                echo "Restarting $unit"
                sudo systemctl restart "$unit"
              fi
            done
          fi

          echo 'Restarting apache2'
          sudo systemctl restart apache2
          sudo systemctl is-active --quiet apache2

          echo '=== local health ==='
          body="$(mktemp)"
          code="$(curl --silent --show-error --output "$body" --connect-timeout 5 --max-time 20 -H 'Host: shopvivaliz.com.br' --write-out '%{http_code}' http://127.0.0.1/api/health/version.php || true)"
          cat "$body" || true
          rm -f "$body"
          echo
          echo "local_http_code=$code"
          test "$code" = '200'
          REMOTE

      - name: Verify external endpoint
        shell: bash
        run: |
          set -euo pipefail
          for attempt in 1 2 3 4; do
            code="$(curl --silent --show-error --output /tmp/home.html --connect-timeout 10 --max-time 25 --write-out '%{http_code}' https://shopvivaliz.com.br/ || true)"
            echo "attempt=$attempt http_code=$code"
            if [[ "$code" = '200' ]]; then
              exit 0
            fi
            sleep $((attempt * 5))
          done
          echo 'External storefront still unavailable after controlled service restart.' >&2
          exit 1
