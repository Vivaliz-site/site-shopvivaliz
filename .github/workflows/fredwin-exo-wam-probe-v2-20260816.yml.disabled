name: Fred-Win EXO WAM probe v2 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/fredwin-exo-wam-probe-v2-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Probe Windows session via Fred-Win MCP
        run: |
          set -euo pipefail
          COMMAND='C:\Windows\System32\cmd.exe /d /c "echo USER=%USERNAME% & echo CD=%CD% & where powershell.exe & where pwsh.exe 2>nul & tasklist /FI \"IMAGENAME eq explorer.exe\""'
          CMD_B64="$(printf '%s' "$COMMAND" | base64 -w0)"
          ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i ~/.ssh/vmkey ubuntu@137.131.156.17 "FREDWIN_CMD_B64='$CMD_B64' python3 - <<'PY'
          import base64,json,os,urllib.request
          command=base64.b64decode(os.environ['FREDWIN_CMD_B64']).decode()
          body=json.dumps({'params':{'command':command,'timeout':45}}).encode()
          req=urllib.request.Request('http://127.0.0.1:5557/mcp/tool/execute_command',data=body,headers={'Content-Type':'application/json'},method='POST')
          with urllib.request.urlopen(req,timeout=55) as r:
              payload=json.loads(r.read().decode())
          print(json.dumps(payload,ensure_ascii=False))
          PY"
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
