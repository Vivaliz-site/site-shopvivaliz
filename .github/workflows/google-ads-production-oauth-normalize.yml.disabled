name: Google Ads Production OAuth Normalize

# on:
#   workflow_dispatch:
#   push:
#     branches: [main]
#     paths:
#       - "ops/google-ads-production-oauth-normalize.json"
#       - ".github/workflows/google-ads-production-oauth-normalize.yml"

permissions:
  contents: read

jobs:
  normalize:
    runs-on: ubuntu-latest
    timeout-minutes: 12
    environment: Production
    env:
      GOOGLE_OAUTH_CLIENT_ID: ${{ secrets.GOOGLE_OAUTH_CLIENT_ID }}
      GOOGLE_OAUTH_CLIENT_SECRET: ${{ secrets.GOOGLE_OAUTH_CLIENT_SECRET }}
      GOOGLE_ADS_REFRESH_TOKEN: ${{ secrets.GOOGLE_ADS_REFRESH_TOKEN }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Test normalized client against Google token endpoint
        id: probe
        shell: bash
        run: |
          python - <<'PY'
          import json, os, urllib.parse, urllib.request, urllib.error
          from pathlib import Path

          cid=os.environ.get('GOOGLE_OAUTH_CLIENT_ID','').strip()
          secret=os.environ.get('GOOGLE_OAUTH_CLIENT_SECRET','').strip()
          refresh=os.environ.get('GOOGLE_ADS_REFRESH_TOKEN','').strip()
          if not all((cid,secret,refresh)):
              print('PRODUCTION_OAUTH_PROBE_NOT_READY')
              raise SystemExit(2)
          candidate=cid.replace('.app.s.googleusercontent.com','.apps.googleusercontent.com')
          current_valid=cid.endswith('.apps.googleusercontent.com')
          candidate_valid=candidate.endswith('.apps.googleusercontent.com')
          print('current_format_valid=' + str(current_valid))
          print('candidate_format_valid=' + str(candidate_valid))
          print('candidate_differs=' + str(candidate != cid))
          if not candidate_valid:
              print('candidate_status=FORMAT_INVALID')
              raise SystemExit(3)
          data=urllib.parse.urlencode({
              'client_id':candidate,
              'client_secret':secret,
              'refresh_token':refresh,
              'grant_type':'refresh_token',
          }).encode()
          req=urllib.request.Request('https://oauth2.googleapis.com/token', data=data, headers={'Content-Type':'application/x-www-form-urlencoded'}, method='POST')
          status='UNKNOWN'
          try:
              with urllib.request.urlopen(req, timeout=20) as r:
                  payload=json.loads(r.read().decode())
              status='SUCCESS' if payload.get('access_token') else 'UNEXPECTED_RESPONSE'
          except urllib.error.HTTPError as e:
              try: payload=json.loads(e.read().decode(errors='ignore'))
              except Exception: payload={}
              err=str(payload.get('error','')).lower()
              status={'invalid_client':'INVALID_CLIENT','invalid_grant':'INVALID_GRANT','unauthorized_client':'UNAUTHORIZED_CLIENT'}.get(err,'HTTP_ERROR_'+str(e.code))
          print('candidate_status=' + status)
          accepted=status in {'SUCCESS','INVALID_GRANT'}
          print('candidate_client_secret_accepted=' + str(accepted))
          Path('/tmp/google-oauth-candidate.txt').write_text(candidate, encoding='utf-8')
          Path('/tmp/google-oauth-status.txt').write_text(status, encoding='utf-8')
          with open(os.environ['GITHUB_OUTPUT'],'a',encoding='utf-8') as f:
              f.write('accepted=' + ('true' if accepted else 'false') + '\n')
              f.write('status=' + status + '\n')
          if not accepted:
              raise SystemExit(4)
          PY

      - name: Configure VM key
        if: steps.probe.outputs.accepted == 'true'
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          test -n "$VM_KEY" || { echo "SHOPVIVALIZ_VM_SSH_KEY missing"; exit 2; }
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey

      - name: Update Production client id through Fred-Win authenticated gh
        if: steps.probe.outputs.accepted == 'true'
        shell: bash
        run: |
          set -euo pipefail
          CANDIDATE_B64="$(base64 -w0 /tmp/google-oauth-candidate.txt)"
          cat >/tmp/fredwin-set-secret.ps1 <<'PS1'
          $ErrorActionPreference='Stop'
          $candidate=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($env:GOOGLE_OAUTH_CANDIDATE_B64))
          if($candidate -notmatch '^[0-9A-Za-z._-]+\.apps\.googleusercontent\.com$'){ throw 'CANDIDATE_FORMAT_INVALID' }
          gh auth status --hostname github.com *> $null
          if($LASTEXITCODE -ne 0){ throw 'GH_AUTH_NOT_READY' }
          $candidate | gh secret set GOOGLE_OAUTH_CLIENT_ID --env Production --repo Vivaliz-site/site-shopvivaliz
          if($LASTEXITCODE -ne 0){ throw 'GH_SECRET_UPDATE_FAILED' }
          Write-Output 'PRODUCTION_OAUTH_CLIENT_ID_UPDATED'
          Write-Output 'NO_SECRET_VALUES_PRINTED'
          PS1
          PS_B64="$(iconv -f UTF-8 -t UTF-16LE /tmp/fredwin-set-secret.ps1 | base64 -w0)"
          COMMAND="set GOOGLE_OAUTH_CANDIDATE_B64=$CANDIDATE_B64&& powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand $PS_B64"
          printf '%s' "$COMMAND" | base64 -w0 >/tmp/fredwin-command.b64
          CMD_B64="$(cat /tmp/fredwin-command.b64)"
          ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -i ~/.ssh/vmkey ubuntu@137.131.156.17 \
            "curl -fsS --connect-timeout 5 --max-time 10 http://127.0.0.1:5557/health >/dev/null && FREDWIN_CMD_B64='$CMD_B64' python3 - <<'PY'
          import base64, json, os, urllib.request
          command=base64.b64decode(os.environ['FREDWIN_CMD_B64']).decode('utf-8')
          body=json.dumps({'params':{'command':command,'timeout':60}}).encode()
          req=urllib.request.Request('http://127.0.0.1:5557/mcp/tool/execute_command',data=body,headers={'Content-Type':'application/json'},method='POST')
          with urllib.request.urlopen(req,timeout=75) as r: payload=json.loads(r.read().decode())
          result=payload.get('result') or {}
          print(result.get('output') or '')
          if result.get('error'): print('REMOTE_ERROR=' + str(result.get('error')))
          if result.get('success') is not True: raise SystemExit('PRODUCTION_SECRET_UPDATE_FAILED')
          PY"

      - name: Install Google Ads SDK
        if: steps.probe.outputs.status == 'SUCCESS'
        run: python -m pip install --disable-pip-version-check google-ads

      - name: Read-only account audit with normalized client
        if: steps.probe.outputs.status == 'SUCCESS'
        env:
          GOOGLE_ADS_CUSTOMER_ID: ${{ secrets.GOOGLE_ADS_CUSTOMER_ID }}
          GOOGLE_ADS_LOGIN_CUSTOMER_ID: ${{ secrets.GOOGLE_ADS_LOGIN_CUSTOMER_ID }}
          GOOGLE_ADS_DEVELOPER_TOKEN: ${{ secrets.GOOGLE_ADS_DEVELOPER_TOKEN }}
        shell: bash
        run: |
          export GOOGLE_OAUTH_CLIENT_ID="$(cat /tmp/google-oauth-candidate.txt)"
          python scripts/google_ads_review_campaigns.py
          python scripts/google_ads_dynamic_images.py

      - name: Report refresh-token follow-up
        if: steps.probe.outputs.status == 'INVALID_GRANT'
        run: |
          echo 'OAUTH_CLIENT_AND_SECRET_ACCEPTED'
          echo 'REFRESH_TOKEN_REISSUE_REQUIRED'
          echo 'NO_SECRET_VALUES_PRINTED'

      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey /tmp/google-oauth-candidate.txt /tmp/google-oauth-status.txt /tmp/fredwin-set-secret.ps1 /tmp/fredwin-command.b64
