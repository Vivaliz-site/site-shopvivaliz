name: MEI email cancel V021 pid3117 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/mei-email-cancel-v021-pid3117-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  cancel:
    runs-on: ubuntu-latest
    timeout-minutes: 4
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Cancel known V021 backend
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 '
            set -euo pipefail
            echo NOW=$(date -Is)
            echo ---PID3117_BEFORE---
            sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -P pager=off -x -c "select pid, client_addr, state, wait_event_type, wait_event, query_start, query from pg_stat_activity where pid=3117;" || true
            echo ---CANCEL---
            sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -P pager=off -x -c "select pg_cancel_backend(3117) where exists(select 1 from pg_stat_activity where pid=3117);" || true
            sleep 5
            echo ---PID3117_AFTER_CANCEL---
            sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -P pager=off -x -c "select pid, state, wait_event_type, wait_event, query_start, query from pg_stat_activity where pid=3117;" || true
            left=$(sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -Atqc "select count(*) from pg_stat_activity where pid=3117;" || echo 0)
            if [ "${left:-0}" != "0" ]; then
              echo ---TERMINATE---
              sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -P pager=off -x -c "select pg_terminate_backend(3117);" || true
              sleep 3
            fi
            echo ---FINAL---
            sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -Atqc "select count(*) from pg_stat_activity where pid=3117;" || true
            ps -eo pid,ppid,etime,stat,pcpu,pmem,wchan:28,cmd | grep "[p]ostgres: postgres mei_mg_email" || true
            echo WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
            if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo SENTINEL=present; else echo SENTINEL=absent; fi
          '
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
