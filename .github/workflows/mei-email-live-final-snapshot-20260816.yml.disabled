name: MEI email live final snapshot 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/mei-email-live-final-snapshot-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  snapshot:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Capture worker DB and journal state
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          cd /home/ubuntu/mei-mg-email
          echo NOW=$(date -Is)
          echo HEAD=$(git rev-parse HEAD)
          echo WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          echo PID=$(systemctl show -p MainPID --value mei-mg-email-worker.service 2>/dev/null || true)
          if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo SENTINEL=present; else echo SENTINEL=absent; fi
          echo ---WORKER_PS---
          pid=$(systemctl show -p MainPID --value mei-mg-email-worker.service 2>/dev/null || true)
          [ -n "$pid" ] && ps -o pid,ppid,etime,stat,pcpu,pmem,wchan:28,cmd -p "$pid" || true
          echo ---DB---
          .venv/bin/python - <<'PY'
          from dotenv import load_dotenv
          load_dotenv('.env', override=True)
          import psycopg
          from psycopg.rows import dict_row
          from app.config import settings
          conn=psycopg.connect(settings.database_url, autocommit=True, row_factory=dict_row, connect_timeout=15)
          with conn.cursor() as cur:
              cur.execute("set statement_timeout='15000ms'")
              print('ACTIVE_SESSIONS')
              cur.execute("""
                select pid,state,wait_event_type,wait_event,
                       round(extract(epoch from(clock_timestamp()-query_start))::numeric,1) age_s,
                       pg_blocking_pids(pid) blockers,
                       left(regexp_replace(query,'\\s+',' ','g'),700) query
                  from pg_stat_activity
                 where datname=current_database() and pid<>pg_backend_pid()
                 order by query_start nulls last
              """)
              for r in cur.fetchall(): print(dict(r))
              print('ACTIVE_LOTS')
              cur.execute("""
                select id,campanha_id,numero,status,tamanho,tentativas,iniciado_em,concluido_em,erro
                  from mei_email.lotes
                 where status in ('pendente','processando')
                 order by case when status='processando' then 0 else 1 end, criado_em
                 limit 10
              """)
              lots=cur.fetchall()
              for r in lots: print(dict(r))
              for lot in lots[:2]:
                  cur.execute("""
                    select status::text status,count(*) n
                      from mei_email.envios
                     where lote_id=%s
                     group by status::text
                     order by status::text
                  """,(lot['id'],))
                  print('LOT_STATUS',lot['id'],[dict(x) for x in cur.fetchall()])
              print('QUOTA24')
              cur.execute("select count(*) n from mei_email.envios where status in ('submitted','enviado') and enviado_em>=now()-interval '24 hours'")
              print(dict(cur.fetchone()))
          conn.close()
          PY
          echo ---JOURNAL---
          sudo journalctl -u mei-mg-email-worker.service --since "10 minutes ago" --no-pager -n 300 || true
          EOF
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
