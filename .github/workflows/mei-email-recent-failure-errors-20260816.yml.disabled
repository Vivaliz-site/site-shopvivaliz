name: MEI email recent failure errors 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/mei-email-recent-failure-errors-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  inspect:
    runs-on: ubuntu-latest
    timeout-minutes: 4
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Query only two recent campaigns
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          cd /home/ubuntu/mei-mg-email
          .venv/bin/python - <<'PY'
          from dotenv import load_dotenv
          load_dotenv('.env', override=True)
          import psycopg
          from psycopg.rows import dict_row
          from app.config import settings
          ids=['136c1375-3332-41d7-a9aa-76569e7f04ec','ea078424-4e0c-45d0-a91b-88d8527f7d90']
          conn=psycopg.connect(settings.database_url, autocommit=True, row_factory=dict_row, connect_timeout=15)
          with conn.cursor() as cur:
              cur.execute("set statement_timeout='15000ms'")
              for cid in ids:
                  print('---CAMPAIGN',cid,'---')
                  cur.execute("""
                    select status::text as status, count(*) as n,
                           coalesce(erro,'') as erro
                      from mei_email.envios
                     where campanha_id=%s
                     group by status::text, coalesce(erro,'')
                     order by n desc
                  """, (cid,))
                  rows=cur.fetchall()
                  print('GROUPS',len(rows))
                  for r in rows: print(dict(r))
                  cur.execute("""
                    select id, lote_id, email::text as email, status::text as status,
                           tentativas, left(coalesce(erro,''),700) as erro,
                           provider_message_id, enviado_em
                      from mei_email.envios
                     where campanha_id=%s
                     order by id
                     limit 30
                  """, (cid,))
                  for r in cur.fetchall(): print('ROW',dict(r))
          conn.close()
          PY
          EOF
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
