name: MEI email remove redundant enqueue cron 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/mei-email-remove-redundant-enqueue-cron-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  fix:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Disable redundant cron and terminate current replenisher
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 '
            set -euo pipefail
            ts=$(date +%Y%m%d-%H%M%S)
            crontab -l > "$HOME/crontab.before-mei-enqueue-fix-$ts.txt"
            crontab -l | grep -v "scripts/disparar_10000_mei_mg.py" | crontab -
            echo ---CRONTAB_AFTER---
            crontab -l
            echo ---PROCESSES_BEFORE_TERM---
            ps -eo pid,ppid,etime,stat,cmd | grep -E "[d]isparar_10000_mei_mg|mei-mg-email-daily-enqueue" || true
            pids=$(pgrep -f "/home/ubuntu/mei-mg-email/.venv/bin/python scripts/disparar_10000_mei_mg.py" || true)
            if [ -n "$pids" ]; then
              echo TERM_PIDS="$pids"
              kill -TERM $pids || true
              sleep 4
            fi
            pids2=$(pgrep -f "/home/ubuntu/mei-mg-email/.venv/bin/python scripts/disparar_10000_mei_mg.py" || true)
            if [ -n "$pids2" ]; then
              echo KILL_PIDS="$pids2"
              kill -KILL $pids2 || true
              sleep 2
            fi
            echo ---PROCESSES_AFTER---
            ps -eo pid,ppid,etime,stat,cmd | grep -E "[d]isparar_10000_mei_mg|mei-mg-email-daily-enqueue" || true
            echo WORKER=$(sudo systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
            if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo SENTINEL=present; else echo SENTINEL=absent; fi
          '
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
