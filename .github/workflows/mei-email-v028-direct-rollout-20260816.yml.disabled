name: MEI email V028 direct rollout 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/mei-email-v028-direct-rollout-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  rollout:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Apply only V028 and restart worker
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          cd /home/ubuntu/mei-mg-email
          if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
            echo REFUSE_TRACKED_WORKTREE_CHANGES
            git status --short --untracked-files=no
            exit 20
          fi

          echo BEFORE_HEAD=$(git rev-parse HEAD)
          echo BEFORE_WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo BEFORE_SENTINEL=present; else echo BEFORE_SENTINEL=absent; fi

          timeout 15 sudo systemctl stop mei-mg-email-worker.service || true
          if [ "$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)" != "inactive" ]; then
            echo FORCE_KILL_OLD_WORKER=true
            sudo systemctl kill --kill-who=main --signal=SIGKILL mei-mg-email-worker.service || true
            sleep 4
          fi
          echo STOPPED_WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          sleep 3

          git fetch origin main
          git pull --ff-only origin main
          echo AFTER_PULL_HEAD=$(git rev-parse HEAD)
          test -f db/migrations/V028__optimize_retention_triggers.sql
          .venv/bin/python -m py_compile worker/worker_queue_first.py worker/worker.py app/queue_manager.py
          echo PY_COMPILE=ok

          echo ---APPLY_ONLY_V028_TRANSACTION---
          sudo docker exec -i mei-mg-email-db psql -U postgres -d mei_mg_email -v ON_ERROR_STOP=1 -1 < db/migrations/V028__optimize_retention_triggers.sql
          echo V028_SQL_APPLIED=true

          echo ---VERIFY_V028---
          sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -v ON_ERROR_STOP=1 -P pager=off -x -c "
            select to_regprocedure('mei_email.cleanup_expired_quota_ledgers(integer)') as cleanup_fn,
                   position('delete from mei_email.envios e' in pg_get_functiondef('mei_email.trg_archive_envio_and_purge_pii()'::regprocedure)) > 0 as archive_fn_present;
          "

          sudo systemctl daemon-reload
          sudo systemctl start mei-mg-email-worker.service
          sleep 35
          echo AFTER_WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          echo AFTER_PID=$(systemctl show -p MainPID --value mei-mg-email-worker.service 2>/dev/null || true)
          if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo AFTER_SENTINEL=present; else echo AFTER_SENTINEL=absent; fi
          echo ---JOURNAL---
          sudo journalctl -u mei-mg-email-worker.service --since "3 minutes ago" --no-pager -n 180 || true
          EOF
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
