name: MEI email V030 direct rollout 20260816
on:
  push:
    branches: [main]
    paths: ['.github/workflows/mei-email-v030-direct-rollout-20260816.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  rollout:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Configure VM key
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          mkdir -p ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/vmkey
          chmod 600 ~/.ssh/vmkey
      - name: Apply V030, recover orphan lots and restart worker
        run: |
          set -euo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=no -i ~/.ssh/vmkey ubuntu@137.131.156.17 <<'EOF'
          set -euo pipefail
          cd /home/ubuntu/mei-mg-email
          if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
            echo REFUSE_TRACKED_WORKTREE_CHANGES
            git status --short --untracked-files=no
            exit 20
          fi

          echo NOW=$(date -Is)
          echo BEFORE_HEAD=$(git rev-parse HEAD)
          echo BEFORE_WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo BEFORE_SENTINEL=present; else echo BEFORE_SENTINEL=absent; fi

          timeout 15 sudo systemctl stop mei-mg-email-worker.service || true
          if [ "$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)" != "inactive" ]; then
            sudo systemctl kill --kill-who=main --signal=SIGKILL mei-mg-email-worker.service || true
            sleep 4
          fi
          echo STOPPED_WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)

          git fetch origin main
          git pull --ff-only origin main
          echo AFTER_PULL_HEAD=$(git rev-parse HEAD)
          test -f db/migrations/V030__quota_window_index.sql
          .venv/bin/python -m py_compile worker/worker_queue_first.py worker/worker.py app/queue_manager.py
          echo PY_COMPILE=ok

          echo ---APPLY_ONLY_V030---
          {
            printf '%s\n' "set maintenance_work_mem='32MB';" "set statement_timeout='180s';"
            cat db/migrations/V030__quota_window_index.sql
          } | sudo docker exec -i mei-mg-email-db psql -U postgres -d mei_mg_email -v ON_ERROR_STOP=1 -1
          echo V030_SQL_APPLIED=true

          echo ---RECOVER_ORPHAN_PROCESSING---
          sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -v ON_ERROR_STOP=1 -P pager=off -x -c "
            with reset_lotes as (
              update mei_email.lotes
                 set status='pendente', iniciado_em=null,
                     erro=coalesce(erro || ' | ','') || 'reset_controlado_v030'
               where status='processando'
               returning id
            ), reset_envios as (
              update mei_email.envios
                 set status='pendente'
               where status='enviando'
               returning id
            )
            select (select count(*) from reset_lotes) as lotes_resetados,
                   (select count(*) from reset_envios) as envios_resetados;
          "

          echo ---VERIFY_QUOTA_INDEX---
          sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -v ON_ERROR_STOP=1 -P pager=off -x -c "
            select c.relname, pg_size_pretty(pg_relation_size(c.oid)) as size, i.indisvalid, i.indisready
              from pg_class c
              join pg_namespace n on n.oid=c.relnamespace
              join pg_index i on i.indexrelid=c.oid
             where n.nspname='mei_email' and c.relname='idx_envios_quota_24h';
          "
          sudo docker exec mei-mg-email-db psql -U postgres -d mei_mg_email -v ON_ERROR_STOP=1 -P pager=off -c "set statement_timeout='10s'; explain (analyze, buffers, timing off, summary on) select count(*) from mei_email.envios where status in ('submitted','enviado') and enviado_em >= now()-interval '24 hours';"

          sudo systemctl reset-failed mei-mg-email-worker.service || true
          sudo systemctl daemon-reload
          sudo systemctl start mei-mg-email-worker.service
          sleep 90
          echo AFTER_WORKER=$(systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          echo AFTER_PID=$(systemctl show -p MainPID --value mei-mg-email-worker.service 2>/dev/null || true)
          if [ -f /var/lib/mei-mg-email/sender_blocked.pause ]; then echo AFTER_SENTINEL=present; else echo AFTER_SENTINEL=absent; fi
          echo ---JOURNAL---
          sudo journalctl -u mei-mg-email-worker.service --since "5 minutes ago" --no-pager -n 260 || true
          EOF
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/vmkey
