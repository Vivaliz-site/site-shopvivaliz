name: OCI A1 bootstrap (instala retry persistente na VM)

# Autorizado por Fred em 2026-08-26 (sessao Cowork). Objetivo: entregar as
# credenciais OCI_CLI_* (ja configuradas nos secrets do repo) pra dentro da
# VM shopvivaliz-ai (137.131.156.17, ambiente dev -- ver CLAUDE.md secao
# "VM1 vs VM2"), instalar a oci CLI la, copiar scripts/oci-a1-retry.sh e
# registrar um cron persistente (*/3 * * * *, com flock pra nao sobrepor
# execucoes) que tenta provisionar a shopvivaliz-free-a1 (Ampere A1.Flex,
# Always Free) indefinidamente ate a Oracle liberar capacidade na regiao
# sa-saopaulo-1. O cron sobrevive a reboot (fica no crontab do usuario
# ubuntu na VM, nao depende deste workflow nem de nenhuma sessao aberta).
#
# Este workflow roda uma vez (disparado por push nestes arquivos, ou manual
# via workflow_dispatch) so pra fazer a entrega/instalacao -- a execucao
# recorrente de fato acontece via cron dentro da VM, nao aqui.

on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/oci-a1-bootstrap.yml'
      - 'scripts/oci-a1-retry.sh'
  workflow_dispatch: {}

jobs:
  bootstrap:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Instalar chave SSH da VM
        run: |
          mkdir -p ~/.ssh
          printf '%s' "${{ secrets.ORACLE_VM_SSH_KEY }}" > ~/.ssh/oracle_vm_key
          chmod 600 ~/.ssh/oracle_vm_key
          printf '%s' "${{ secrets.ORACLE_VM_KNOWN_HOSTS }}" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/known_hosts

      - name: Montar config OCI local (pra validar antes de copiar pra VM)
        env:
          OCI_CLI_USER: ${{ secrets.OCI_CLI_USER }}
          OCI_CLI_TENANCY: ${{ secrets.OCI_CLI_TENANCY }}
          OCI_CLI_FINGERPRINT: ${{ secrets.OCI_CLI_FINGERPRINT }}
          OCI_CLI_REGION: ${{ secrets.OCI_CLI_REGION }}
          OCI_CLI_KEY_CONTENT: ${{ secrets.OCI_CLI_KEY_CONTENT }}
        run: |
          set -euo pipefail
          mkdir -p /tmp/oci-config
          printf '%s' "$OCI_CLI_KEY_CONTENT" > /tmp/oci-config/key.pem
          chmod 600 /tmp/oci-config/key.pem
          cat > /tmp/oci-config/config <<EOF
          [DEFAULT]
          user=$OCI_CLI_USER
          fingerprint=$OCI_CLI_FINGERPRINT
          tenancy=$OCI_CLI_TENANCY
          region=$OCI_CLI_REGION
          key_file=/home/ubuntu/.oci/key.pem
          EOF
          echo "Config montado (sem exibir valores sensiveis)."
          grep -c '=' /tmp/oci-config/config

      - name: Copiar credenciais + script de retry para a VM (137.131.156.17)
        run: |
          set -euo pipefail
          SSH="ssh -i ~/.ssh/oracle_vm_key -o UserKnownHostsFile=~/.ssh/known_hosts ubuntu@137.131.156.17"
          SCP="scp -i ~/.ssh/oracle_vm_key -o UserKnownHostsFile=~/.ssh/known_hosts"

          $SSH "mkdir -p ~/.oci && chmod 700 ~/.oci"
          $SCP /tmp/oci-config/config ubuntu@137.131.156.17:~/.oci/config
          $SCP /tmp/oci-config/key.pem ubuntu@137.131.156.17:~/.oci/key.pem
          $SSH "chmod 600 ~/.oci/config ~/.oci/key.pem"

          $SCP scripts/oci-a1-retry.sh ubuntu@137.131.156.17:/tmp/oci-a1-retry.sh
          $SSH "sudo mv /tmp/oci-a1-retry.sh /usr/local/bin/oci-a1-retry.sh && sudo chmod 755 /usr/local/bin/oci-a1-retry.sh"

          # limpa o config local do runner (nao deixar segredo no workspace do job)
          shred -u /tmp/oci-config/key.pem /tmp/oci-config/config 2>/dev/null || rm -f /tmp/oci-config/key.pem /tmp/oci-config/config

      - name: Instalar oci CLI na VM (se ainda nao estiver instalada)
        run: |
          set -euo pipefail
          SSH="ssh -i ~/.ssh/oracle_vm_key -o UserKnownHostsFile=~/.ssh/known_hosts ubuntu@137.131.156.17"
          $SSH 'command -v oci >/dev/null 2>&1 && echo "oci CLI ja instalada: $(oci --version)" || (sudo apt-get update -qq && sudo apt-get install -y -qq python3-pip >/dev/null && pip3 install --user --quiet oci-cli && echo "export PATH=\$HOME/.local/bin:\$PATH" >> ~/.bashrc && ~/.local/bin/oci --version)'

      - name: Registrar cron persistente (*/3 * * * *, com flock, sobrevive a reboot)
        run: |
          set -euo pipefail
          SSH="ssh -i ~/.ssh/oracle_vm_key -o UserKnownHostsFile=~/.ssh/known_hosts ubuntu@137.131.156.17"
          $SSH '
            ( crontab -l 2>/dev/null | grep -v "oci-a1-retry.sh" ; echo "*/3 * * * * PATH=/usr/bin:/bin:$HOME/.local/bin flock -n /tmp/oci-a1-retry.lock /usr/local/bin/oci-a1-retry.sh" ) | crontab -
            echo "--- crontab instalado ---"
            crontab -l
          '

      - name: Rodar uma vez agora (primeira tentativa imediata, nao esperar 3min)
        run: |
          set -euo pipefail
          SSH="ssh -i ~/.ssh/oracle_vm_key -o UserKnownHostsFile=~/.ssh/known_hosts ubuntu@137.131.156.17"
          $SSH 'PATH=/usr/bin:/bin:$HOME/.local/bin /usr/local/bin/oci-a1-retry.sh; echo "--- log apos primeira execucao ---"; tail -30 "$HOME/oci-a1-retry.log"'
