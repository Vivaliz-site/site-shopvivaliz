name: Cancel stuck Fred-Win smoke 31972553113
on:
  push:
    branches: [main]
    paths: ['.github/workflows/tmp-cancel-fredwin-smoke-31972553113.yml']
  workflow_dispatch:
permissions:
  actions: write
  contents: read
jobs:
  cancel:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - name: Cancel only stuck Fred-Win read-only smoke
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          RUN_ID: '31972553113'
        run: |
          set -euo pipefail
          code=$(curl -sS -o /tmp/cancel.out -w '%{http_code}' \
            -X POST \
            -H "Authorization: Bearer $GH_TOKEN" \
            -H 'Accept: application/vnd.github+json' \
            -H 'X-GitHub-Api-Version: 2022-11-28' \
            "https://api.github.com/repos/$REPO/actions/runs/$RUN_ID/cancel")
          echo "CANCEL_HTTP=$code"
          cat /tmp/cancel.out || true
          case "$code" in 202|409) exit 0;; *) exit 1;; esac
