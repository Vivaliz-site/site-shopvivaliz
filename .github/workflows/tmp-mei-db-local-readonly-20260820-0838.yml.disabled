name: MEI DB Local Readonly 20260820 0838
on:
  push:
    paths:
      - '.github/workflows/tmp-mei-db-local-readonly-20260820-0838.yml'
permissions:
  contents: write
jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - name: Configure SSH
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
      - name: Probe local database read-only
        run: |
          set -euo pipefail
          mkdir -p reports
          ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -i ~/.ssh/id_rsa ubuntu@137.131.156.17 <<'EOF' > reports/mei-db-local-readonly-20260820-0838.txt 2>&1
          set -u
          echo "BRT=$(TZ=America/Sao_Paulo date +%Y-%m-%dT%H:%M:%S%z)"
          echo "WORKER=$(sudo systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)"
          echo "WORKER_ENABLED=$(sudo systemctl is-enabled mei-mg-email-worker.service 2>/dev/null || true)"
          if sudo test -f /var/lib/mei-mg-email/sender_blocked.pause || test -f /home/ubuntu/mei-mg-email/runtime/sender_blocked.pause; then echo SENTINEL=present; else echo SENTINEL=absent; fi
          echo 'DOCKER_BEGIN'
          sudo docker ps --format '{{.Names}} {{.Status}}' | grep -E 'mei-mg-email-db|mei-mg-email' || true
          sudo docker exec mei-mg-email-db pg_isready -U postgres -d mei_mg_email || true
          echo 'DOCKER_END'
          psqlq() { sudo docker exec mei-mg-email-db psql -X -v ON_ERROR_STOP=1 -U postgres -d mei_mg_email -Atc "set statement_timeout='10s'; $1"; }
          echo 'FLYWAY_BEGIN'
          psqlq "select version||'|'||description||'|'||success||'|'||installed_on from mei_email.flyway_schema_history where version in ('37','38','39','40','41','42') order by installed_rank" || true
          echo 'FLYWAY_END'
          echo "ELIGIBLE=$(psqlq \"select count(*) from mei_email.vw_empresas_elegiveis\" 2>&1 || true)"
          echo "OPEN_QUEUE=$(psqlq \"select count(*) from mei_email.envios where status::text in ('pendente','enviando','pending','processing')\" 2>&1 || true)"
          echo "STALE_SENDING=$(psqlq \"select count(*) from mei_email.envios e join mei_email.lotes l on l.id=e.lote_id where e.status::text='enviando' and l.status::text='processando' and l.iniciado_em < now()-interval '15 minutes'\" 2>&1 || true)"
          echo "ORPHAN_ENVIOS=$(psqlq \"select count(*) from mei_email.envios e left join mei_email.lotes l on l.id=e.lote_id where e.lote_id is not null and l.id is null\" 2>&1 || true)"
          echo "OPEN_SUPPRESSED=$(psqlq \"select count(*) from mei_email.envios e where e.status::text in ('pendente','enviando','pending','processing') and (mei_email.is_email_suppressed(e.email) or mei_email.is_cnpj_suppressed(e.cnpj::text))\" 2>&1 || true)"
          echo "OPEN_REPLAY=$(psqlq \"select count(*) from mei_email.envios e where e.status::text in ('pendente','enviando','pending','processing') and exists(select 1 from mei_email.envios h where h.id<>e.id and h.status::text in ('submitted','enviado','delivered') and (h.cnpj=e.cnpj or lower(btrim(h.email::text))=lower(btrim(e.email::text))))\" 2>&1 || true)"
          echo "LEGACY_COPY=$(psqlq \"select count(*) from mei_email.campanhas where position('base pública de CNPJ' in corpo_template)>0 or position('base publica de CNPJ' in corpo_template)>0\" 2>&1 || true)"
          echo "SYNTH_AUTH=$(psqlq \"select count(*) from mei_email.empresas where marketing_autorizado is true and (btrim(coalesce(marketing_autorizado_origem,''))='user_explicit_authorization_2026-08-20' or lower(btrim(coalesce(marketing_autorizado_origem,''))) like '%operator_authorization_true%')\" 2>&1 || true)"
          echo 'AUTH_ORIGINS_BEGIN'
          psqlq "select coalesce(marketing_autorizado_origem,'<null>')||'|'||count(*) from mei_email.empresas where marketing_autorizado is true group by 1 order by count(*) desc limit 15" || true
          echo 'AUTH_ORIGINS_END'
          echo 'LOCKS_BEGIN'
          psqlq "select pid||'|'||coalesce(array_to_string(pg_blocking_pids(pid),','),'')||'|'||coalesce(wait_event_type,'')||'|'||coalesce(wait_event,'')||'|'||coalesce((now()-coalesce(xact_start,query_start))::text,'') from pg_stat_activity where datname=current_database() and cardinality(pg_blocking_pids(pid))>0 order by coalesce(xact_start,query_start) limit 20" || true
          echo 'LOCKS_END'
          echo 'SESSIONS_BEGIN'
          psqlq "select state||'|'||count(*) from pg_stat_activity where datname=current_database() group by state order by count(*) desc" || true
          echo 'SESSIONS_END'
          echo "AS42004_LAST30M=$(sudo journalctl -u mei-mg-email-worker.service --since '-30 minutes' --no-pager 2>/dev/null | grep -Eic 'AS\(42004\)|bad outbound sender|5\.1\.8' || true)"
          echo 'JOURNAL_BEGIN'
          sudo journalctl -u mei-mg-email-worker.service --since '-10 minutes' --no-pager 2>/dev/null | tail -n 100 || true
          echo 'JOURNAL_END'
          EOF
      - name: Persist report
        if: always()
        run: |
          set -euo pipefail
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add reports/mei-db-local-readonly-20260820-0838.txt || true
          git commit -m 'ops: capture MEI local DB readonly state 20260820-0838' || exit 0
          git pull --rebase origin main
          git push origin HEAD:main
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/id_rsa
