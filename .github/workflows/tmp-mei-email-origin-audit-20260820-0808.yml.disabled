name: MEI Email Origin Audit 20260820 0808
on:
  push:
    paths:
      - '.github/workflows/tmp-mei-email-origin-audit-20260820-0808.yml'
permissions:
  contents: write
jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: SSH
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
        run: |
          set -euo pipefail
          test -n "$VM_KEY"
          install -m 700 -d ~/.ssh
          printf '%s\n' "$VM_KEY" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
      - name: Audit origins
        run: |
          set -euo pipefail
          mkdir -p reports
          ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -i ~/.ssh/id_rsa ubuntu@137.131.156.17 <<'EOF' > reports/mei-email-origin-audit-20260820-0808.txt 2>&1
          set -euo pipefail
          cd /home/ubuntu/mei-mg-email
          .venv/bin/python - <<'PY'
          import psycopg
          from app.config import settings
          with psycopg.connect(settings.database_url) as conn:
              with conn.cursor() as cur:
                  cur.execute("set statement_timeout='20s'")
                  print('MARKETING_ORIGINS')
                  cur.execute("""select coalesce(marketing_autorizado_origem,'<null>'), marketing_autorizado, count(*) from mei_email.empresas where situacao_cadastral='ATIVA' and upper(uf)='MG' and email is not null group by 1,2 order by 3 desc limit 30""")
                  for r in cur.fetchall(): print(r)
                  print('MEI_ORIGINS')
                  cur.execute("""select coalesce(mei_verificado_origem,'<null>'), mei_verificado, tipo_regime, count(*) from mei_email.empresas where situacao_cadastral='ATIVA' and upper(uf)='MG' and email is not null group by 1,2,3 order by 4 desc limit 30""")
                  for r in cur.fetchall(): print(r)
                  print('GATE_COUNTS')
                  cur.execute("""select count(*) filter(where marketing_autorizado is true), count(*) filter(where mei_verificado is true), count(*) filter(where mei_email.is_independent_marketing_authorization(marketing_autorizado,marketing_autorizado_origem)), count(*) filter(where mei_email.is_independent_mei_verification(mei_verificado,mei_verificado_origem)) from mei_email.empresas where situacao_cadastral='ATIVA' and upper(uf)='MG' and email is not null""")
                  print(cur.fetchone())
          PY
          EOF
      - name: Persist
        run: |
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add reports/mei-email-origin-audit-20260820-0808.txt
          git commit -m 'ops: capture MEI authorization origin audit 20260820-0808' || exit 0
          git pull --rebase origin main
          git push origin HEAD:main
      - name: Cleanup
        if: always()
        run: rm -f ~/.ssh/id_rsa
