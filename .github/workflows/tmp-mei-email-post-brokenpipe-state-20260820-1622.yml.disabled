# watchdog refresh 2026-08-20 20:20 BRT
name: MEI Email Post Broken Pipe State 20260820 1622
on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/tmp-mei-email-post-brokenpipe-state-20260820-1622.yml'
  workflow_dispatch:
permissions:
  contents: write
jobs:
  state:
    runs-on: ubuntu-24.04
    environment: Production
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Configure verified VM SSH
        env:
          PRIMARY_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
          LEGACY_KEY: ${{ secrets.ORACLE_VM_SSH_KEY }}
          PRIMARY_HOSTS: ${{ secrets.SHOPVIVALIZ_VM_KNOWN_HOSTS }}
          LEGACY_HOSTS: ${{ secrets.ORACLE_VM_KNOWN_HOSTS }}
        run: |
          set -Eeuo pipefail
          key="${PRIMARY_KEY:-${LEGACY_KEY:-}}"
          hosts="${PRIMARY_HOSTS:-${LEGACY_HOSTS:-}}"
          test -n "$key" || { echo '::error::Oracle SSH key missing'; exit 2; }
          test -n "$hosts" || { echo '::error::Oracle known_hosts missing'; exit 2; }
          install -m 700 -d "$HOME/.ssh"
          printf '%s\n' "$key" > "$HOME/.ssh/id_rsa"
          printf '%s\n' "$hosts" > "$HOME/.ssh/known_hosts"
          chmod 600 "$HOME/.ssh/id_rsa" "$HOME/.ssh/known_hosts"
      - name: Audit production and recover worker only when Microsoft is not blocking
        run: |
          set -Eeuo pipefail
          mkdir -p reports
          ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$HOME/.ssh/known_hosts" -o ConnectTimeout=12 -o ServerAliveInterval=10 -o ServerAliveCountMax=6 -i "$HOME/.ssh/id_rsa" ubuntu@137.131.156.17 'bash -s' 2>&1 <<'REMOTE' | tee reports/mei-email-post-brokenpipe-state-20260820-1622.txt
          set -u -o pipefail
          echo CHECK_BRT=$(TZ=America/Sao_Paulo date +%Y-%m-%dT%H:%M:%S%z)
          worker=$(sudo systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          enabled=$(sudo systemctl is-enabled mei-mg-email-worker.service 2>/dev/null || true)
          sentinel=absent
          sudo test -f /var/lib/mei-mg-email/sender_blocked.pause && sentinel=present || true
          sudo test -f /home/ubuntu/mei-mg-email/runtime/sender_blocked.pause && sentinel=present || true
          asn=$(sudo journalctl -u mei-mg-email-worker.service --since '-30 minutes' --no-pager | grep -Eic 'AS\(42004\)|bad outbound sender|5\.1\.8' || true)
          echo WORKER_BEFORE=$worker
          echo WORKER_ENABLED_BEFORE=$enabled
          echo SENTINEL=$sentinel
          echo AS42004_LAST30M=$asn
          echo NDR_GUARD=$(sudo systemctl is-active mei-mg-email-ndr-guard.service 2>/dev/null || true)
          echo NDR_GUARD_ENABLED=$(sudo systemctl is-enabled mei-mg-email-ndr-guard.service 2>/dev/null || true)
          sudo systemctl show mei-mg-email-worker.service -p Restart -p RestartUSec -p StartLimitIntervalUSec -p ExecStart -p ExecStartPre --no-pager || true
          echo DB_CONTAINER=$(sudo docker inspect -f '{{.State.Status}}' mei-mg-email-db 2>/dev/null || echo missing)
          echo DB_READY=$(sudo docker exec mei-mg-email-db pg_isready -U postgres -d mei_mg_email 2>/dev/null || true)
          echo DNS_GRAPH=$(getent ahostsv4 graph.microsoft.com 2>/dev/null | head -n1 | awk '{print $1}' || true)
          echo HTTPS_GRAPH=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 10 https://graph.microsoft.com/v1.0/ 2>/dev/null || echo error)
          cd /home/ubuntu/mei-mg-email 2>/dev/null || true
          if [ -x .venv/bin/python ]; then
            .venv/bin/python -c "from dotenv import load_dotenv; load_dotenv('.env', override=True); from app.email_provider import MicrosoftGraphEmailProvider; p=MicrosoftGraphEmailProvider(); t=p._get_access_token(); print('GRAPH_AUTH='+('ok' if t else 'empty')); print('GRAPH_SENDER='+p.address)" 2>&1 || true
          else
            echo GRAPH_AUTH=python_missing
          fi
          q(){ sudo docker exec mei-mg-email-db psql -X -U postgres -d mei_mg_email -At -v ON_ERROR_STOP=1 -c "$1" 2>/dev/null || echo QUERY_ERROR; }
          echo SENT24=$(q "select count(*) from mei_email.envios where status::text in ('submitted','enviado') and enviado_em>=now()-interval '24 hours';")
          echo SENT10=$(q "select count(*) from mei_email.envios where status::text in ('submitted','enviado') and enviado_em>=now()-interval '10 minutes';")
          echo LAST_SENT=$(q "select coalesce(max(enviado_em)::text,'') from mei_email.envios where status::text in ('submitted','enviado');")
          echo OPEN_TOTAL=$(q "select count(*) from mei_email.envios where status::text in ('pendente','pending','enviando','processing');")
          echo STRICT_ELIGIBLE=$(q "set statement_timeout='20s'; select case when to_regclass('mei_email.vw_empresas_elegiveis') is null then -1 else (select count(*) from mei_email.vw_empresas_elegiveis) end;")
          echo OPEN_REPLAY=$(q "select count(*) from mei_email.envios x where x.status::text in ('pendente','pending','enviando','processing') and exists(select 1 from mei_email.envios h where h.id<>x.id and (h.cnpj=x.cnpj or lower(btrim(h.email::text))=lower(btrim(x.email::text))) and h.status::text in ('submitted','enviado','delivered','bounced','bounce_permanent'));")
          echo ORPHAN_ENVIOS=$(q "select count(*) from mei_email.envios e left join mei_email.lotes l on l.id=e.lote_id left join mei_email.campanhas c on c.id=e.campanha_id where l.id is null or c.id is null;")
          echo ADVISORY_LOCKS=$(q "select count(*) from pg_locks where locktype='advisory' and granted;")
          echo LOCK_WAITERS=$(q "select count(*) from pg_stat_activity where wait_event_type='Lock' and pid<>pg_backend_pid();")
          echo LONG_ACTIVE=$(q "select count(*) from pg_stat_activity where datname=current_database() and pid<>pg_backend_pid() and state<>'idle' and query_start<now()-interval '5 minutes';")
          echo LEGACY_COPY=$(q "select count(*) from mei_email.campanhas where lower(coalesce(corpo_template,'')) like '%base pública de cnpj%' or lower(coalesce(corpo_template,'')) like '%base publica de cnpj%';")
          echo GUARD_TRIGGERS=$(q "select count(*) from pg_trigger t join pg_class c on c.oid=t.tgrelid join pg_namespace n on n.oid=c.relnamespace where not t.tgisinternal and n.nspname='mei_email' and t.tgname in ('trg_campaign_copy_policy','trg_envio_live_eligibility');")
          echo FLYWAY_LEDGER_MAX=$(q "select coalesce(max(installed_rank),0) from mei_email.flyway_schema_history;")
          echo FLYWAY_LEDGER_37_38=$(q "select count(*) from mei_email.flyway_schema_history where version in ('37','38') and success;")
          echo SYNTH_AUTH_TRUE=$(q "select count(*) from mei_email.empresas where marketing_autorizado is true and (btrim(coalesce(marketing_autorizado_origem,'')) in ('user_explicit_authorization_2026-08-20','user_campaign_authorization_2026-08-20') or lower(btrim(coalesce(marketing_autorizado_origem,''))) like '%operator_authorization_true%');")
          echo HARD_BOUNCE_ACTIVE=$(q "select count(*) from mei_email.email_suppressions where active and reason='hard_bounce';")
          restart_rc=0
          if [ "$sentinel" = present ] || [ "$asn" -gt 0 ]; then
            echo SAFE_RESTART=BLOCKED_BY_MICROSOFT
          elif [ "$worker" != active ]; then
            sudo systemctl reset-failed mei-mg-email-worker.service || true
            sudo systemctl restart mei-mg-email-worker.service || restart_rc=$?
            echo SAFE_RESTART=YES
            echo RESTART_RC=$restart_rc
          else
            echo SAFE_RESTART=NOT_NEEDED
          fi
          sleep 3
          echo WORKER_AFTER=$(sudo systemctl is-active mei-mg-email-worker.service 2>/dev/null || true)
          echo WORKER_ENABLED_AFTER=$(sudo systemctl is-enabled mei-mg-email-worker.service 2>/dev/null || true)
          echo SYSTEMD_STATUS_BEGIN
          sudo systemctl status mei-mg-email-worker.service --no-pager -l || true
          echo SYSTEMD_STATUS_END
          echo JOURNAL_BEGIN
          sudo journalctl -u mei-mg-email-worker.service --since '-20 minutes' --no-pager | tail -n 200 || true
          echo JOURNAL_END
          REMOTE
      - name: Persist report
        if: always()
        run: |
          set -Eeuo pipefail
          git config user.name shopvivaliz-ops-bot
          git config user.email ops@shopvivaliz.local
          git add reports/mei-email-post-brokenpipe-state-20260820-1622.txt 2>/dev/null || true
          if ! git diff --cached --quiet; then
            git commit -m 'ops: record deep MEI sender recovery state'
            git pull --rebase origin main
            git push origin HEAD:main
          fi
      - name: Cleanup
        if: always()
        run: rm -f "$HOME/.ssh/id_rsa" "$HOME/.ssh/known_hosts"
