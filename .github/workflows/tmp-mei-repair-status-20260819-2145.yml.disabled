name: Snapshot MEI repair workflow status 20260819 2145
on:
  push:
    branches: [main]
    paths: ['.github/workflows/tmp-mei-repair-status-20260819-2145.yml']
permissions:
  actions: read
  contents: write
jobs:
  status:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - uses: actions/checkout@v4
      - name: Record current repair status
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          mkdir -p reports
          out=reports/mei-email-repair-status-20260819-2145.txt
          echo "CHECK_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$out"
          gh run list --repo "$GITHUB_REPOSITORY" --workflow tmp-mei-email-drift-auth-repair-20260819-2140.yml --branch main --limit 3 --json databaseId,status,conclusion,createdAt,updatedAt,url --jq '.' >> "$out"
      - name: Persist status
        run: |
          set -euo pipefail
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add reports/mei-email-repair-status-20260819-2145.txt
          git commit -m 'ops: snapshot MEI repair workflow status 20260819-2145' || exit 0
          git pull --rebase origin main
          git push origin HEAD:main
