name: VM DC Foreground Auth Once
on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/vm-dc-foreground-auth-once.yml'
permissions:
  contents: read
jobs:
  authorize:
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - name: Configure SSH
        env:
          VM_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY || secrets.ORACLE_VM_SSH_KEY }}
          VM_HOSTS: ${{ secrets.SHOPVIVALIZ_VM_KNOWN_HOSTS || secrets.ORACLE_VM_KNOWN_HOSTS }}
        run: |
          install -m 700 -d "$HOME/.ssh"
          printf '%s\n' "$VM_KEY" > "$HOME/.ssh/vmkey"
          printf '%s\n' "$VM_HOSTS" > "$HOME/.ssh/known_hosts"
          chmod 600 "$HOME/.ssh/vmkey" "$HOME/.ssh/known_hosts"
      - name: Generate code in foreground
        run: |
          set +e
          timeout 35s ssh -tt -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$HOME/.ssh/known_hosts" -i "$HOME/.ssh/vmkey" ubuntu@137.131.156.17 'rm -f "$HOME/.desktop-commander-device/device.json" "$HOME/.desktop-commander-device/auth-required.cooldown" "$HOME/.desktop-commander-device/provider-connected.marker"; timeout 30s npx --yes @wonderwhy-er/desktop-commander@0.2.47 remote --persist-session' 2>&1 | tee /tmp/dc-auth.out
          code=$(grep -Eo '[A-Z0-9]{4}-[A-Z0-9]{4}' /tmp/dc-auth.out | tail -1)
          if [ -n "$code" ]; then echo "DEVICE_CODE=$code"; exit 0; fi
          echo DEVICE_CODE_NOT_FOUND
          exit 1
      - name: Cleanup
        if: always()
        run: rm -f "$HOME/.ssh/vmkey" "$HOME/.ssh/known_hosts" /tmp/dc-auth.out
