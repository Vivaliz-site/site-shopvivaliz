name: Old VM slimming phase 2

on:
  issues:
    types: [opened]

permissions:
  contents: read
  issues: read

jobs:
  phase2:
    if: github.event.issue.title == '[vm-slim-phase2b]'
    runs-on: ubuntu-latest
    environment: Production
    timeout-minutes: 10
    steps:
      - name: Configure SSH
        env:
          VM_SSH_KEY: ${{ secrets.SHOPVIVALIZ_VM_SSH_KEY }}
          VM_KNOWN_HOSTS: ${{ secrets.SHOPVIVALIZ_VM_KNOWN_HOSTS }}
        run: |
          set -Eeuo pipefail
          install -m 700 -d "$HOME/.ssh"
          printf '%s\n' "$VM_SSH_KEY" > "$HOME/.ssh/id_rsa"
          printf '%s\n' "$VM_KNOWN_HOSTS" > "$HOME/.ssh/known_hosts"
          chmod 600 "$HOME/.ssh/id_rsa" "$HOME/.ssh/known_hosts"

      - name: Disable proven-unused platform services and verify no regression
        run: |
          set -Eeuo pipefail
          ssh -o BatchMode=yes -o ConnectTimeout=12 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$HOME/.ssh/known_hosts" -i "$HOME/.ssh/id_rsa" ubuntu@137.131.156.17 'bash -s' <<'REMOTE'
          set -Eeuo pipefail
          required=(docker apache2 ssh shopvivaliz-desktop-commander mei-mg-email-worker mei-mg-email-api mei-mg-email-monitor mei-mg-email-ndr-guard mei-mg-email-queue-replenisher)

          echo '=== PRE ==='
          uptime
          free -h
          cloud-id || true
          for unit in "${required[@]}"; do systemctl is-active --quiet "$unit" || { echo "PRE_FAIL=$unit"; exit 3; }; done
          docker ps --format '{{.Names}}' | grep -qx 'mei-mg-email-db' || { echo 'PRE_FAIL=mei-mg-email-db'; exit 3; }
          pre_http=$(curl -sS -o /dev/null --max-time 8 -w '%{http_code}' -H 'Host: shopvivaliz.com.br' http://127.0.0.1/ || true)
          echo "PRE_HTTP=$pre_http"
          ss -lnt | grep -q ':80 ' || { echo 'PRE_FAIL=port80'; exit 3; }
          ss -lnt | grep -q ':443 ' || { echo 'PRE_FAIL=port443'; exit 3; }
          ss -lnt | grep -q '127.0.0.1:8010' || { echo 'PRE_FAIL=port8010'; exit 3; }
          ss -lnt | grep -q '127.0.0.1:5433' || { echo 'PRE_FAIL=port5433'; exit 3; }

          echo '=== EVIDENCE ==='
          systemctl status open-vm-tools.service vgauth.service open-iscsi.service ubuntu-fan.service --no-pager -l || true
          iscsiadm -m session 2>/dev/null || true
          snap services lxd || true
          lxc list 2>/dev/null || true
          ip -brief link

          echo '=== APPLY ==='
          sudo systemctl disable --now open-vm-tools.service vgauth.service open-iscsi.service ubuntu-fan.service || true
          sudo snap stop --disable lxd || true
          sudo systemctl disable --now snap.lxd.daemon.unix.socket snap.lxd.user-daemon.unix.socket snap.lxd.activate.service 2>/dev/null || true
          sleep 12

          echo '=== POST HEALTH ==='
          failed=0
          for unit in "${required[@]}"; do
            if systemctl is-active --quiet "$unit"; then echo "OK=$unit"; else echo "FAIL=$unit"; failed=1; fi
          done
          if docker ps --format '{{.Names}}' | grep -qx 'mei-mg-email-db'; then echo 'OK=mei-mg-email-db'; else echo 'FAIL=mei-mg-email-db'; failed=1; fi
          post_http=$(curl -sS -o /dev/null --max-time 8 -w '%{http_code}' -H 'Host: shopvivaliz.com.br' http://127.0.0.1/ || true)
          echo "POST_HTTP=$post_http"
          [ "$post_http" = "$pre_http" ] || { echo "FAIL=http-regression:$pre_http->$post_http"; failed=1; }
          ss -lnt | grep -q ':80 ' || { echo 'FAIL=port80'; failed=1; }
          ss -lnt | grep -q ':443 ' || { echo 'FAIL=port443'; failed=1; }
          ss -lnt | grep -q '127.0.0.1:8010' || { echo 'FAIL=port8010'; failed=1; }
          ss -lnt | grep -q '127.0.0.1:5433' || { echo 'FAIL=port5433'; failed=1; }

          if [ "$failed" -ne 0 ]; then
            echo '=== ROLLBACK ==='
            sudo systemctl enable open-vm-tools.service vgauth.service open-iscsi.service ubuntu-fan.service 2>/dev/null || true
            sudo systemctl start ubuntu-fan.service 2>/dev/null || true
            sudo snap start --enable lxd 2>/dev/null || true
            exit 2
          fi

          echo '=== FINAL STATES ==='
          systemctl is-enabled open-vm-tools.service vgauth.service open-iscsi.service ubuntu-fan.service 2>/dev/null || true
          systemctl is-active open-vm-tools.service vgauth.service open-iscsi.service ubuntu-fan.service 2>/dev/null || true
          snap services lxd || true
          uptime
          free -h
          ps -eo pid,comm,%cpu,%mem,rss,args --sort=-rss | head -22
          REMOTE

      - name: Cleanup
        if: always()
        run: rm -f "$HOME/.ssh/id_rsa" "$HOME/.ssh/known_hosts"
