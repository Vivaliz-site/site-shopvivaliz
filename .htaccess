# ShopVivaliz - Apache routing

Options -Indexes

# Error Pages
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 502 /502.php
ErrorDocument 503 /503.php

# Bloquear acesso a arquivos sensiveis
<FilesMatch "^(\.env(?:\..*)?|\.htaccess|tasks-queue\.json|mcp-servers\.json|package(?:-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Backups e arquivos temporarios nunca devem ser servidos pelo Apache.
<FilesMatch "\.(?:bak|old|orig|save|swp|tmp)(?:\.[^.]*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "^config/.*\.php$">
    Require all denied
</FilesMatch>

# Charset UTF-8
AddCharset UTF-8 .html .txt .php .json

<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/api/olist/refresh-token\.php(?:\?|$)" SVRT_SENSITIVE=1
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-UA-Compatible "IE=edge"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    # CSP em modo report-only (Rodada 1 de melhoria continua, 2026-08-18): o CSP acima nao tem
    # default-src/script-src, entao hoje nao mitiga XSS (so clickjacking/injecao de <base>). Este
    # segundo header e so-de-observacao -- nunca bloqueia nada, mesmo se a lista estiver incompleta
    # ou errada -- e serve pra comecar o inventario de dominios de terceiros (Google Ads/GA4, Meta,
    # TikTok Pixel, Mercado Pago, InfinitePay, Cloudflare) antes de promover um script-src real e
    # bloqueante (isso sim e mudanca estrutural, aguardando aprovacao -- ver relatorio da Rodada 1).
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://connect.facebook.net https://analytics.tiktok.com https://sdk.mercadopago.com https://http2.mlstatic.com https://checkout.infinitepay.io https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; frame-src 'self' https://sdk.mercadopago.com https://checkout.infinitepay.io"
    Header always set Cache-Control "no-store, max-age=0" env=SVRT_SENSITIVE
    Header always set Pragma "no-cache" env=SVRT_SENSITIVE
</IfModule>

# Uniform session-cookie protection for every PHP entry point. Lax preserves
# OAuth/payment return flows while blocking cross-site subrequests.
<IfModule mod_php.c>
    php_flag session.use_strict_mode On
    php_flag session.use_only_cookies On
    php_flag session.cookie_httponly On
    php_flag session.cookie_secure On
    php_value session.cookie_samesite Lax
    php_flag expose_php Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # O host anterior so serve como entrada de compatibilidade. As rotas
    # legadas de vitrine abaixo convergem para o catalogo atual.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} ^www\.shopvivaliz\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://shopvivaliz.com.br/$1 [R=301,L,NE]

    # Nunca encaminhar operacoes de escrita pelo host legado.
    RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} ^www\.shopvivaliz\.com\.br$ [NC]
    RewriteRule ^ - [F,L]

    # O host de desenvolvimento continua canonizado para producao preservando a rota.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{HTTP_HOST} ^dev\.shopvivaliz\.com\.br$ [NC]
    RewriteRule ^ https://shopvivaliz.com.br%{REQUEST_URI} [R=301,L,NE]

    # Consolidar paginas antigas antes da regra que preserva arquivos reais.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^(?:remote-index\.html|temp_homepage\.html|home(?:\.php)?|index-loja\.php)$ / [R=301,L,NE,QSD]

    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^checkout-legacy/?$ /checkout [R=301,L,NE,QSD]
    RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$ [NC]
    RewriteRule ^checkout-legacy/?$ - [F,L]

    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^carrinho-legacy/?$ /carrinho [R=301,L,NE,QSD]
    RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$ [NC]
    RewriteRule ^carrinho-legacy/?$ - [F,L]

    # Bloquear superficies legadas que ainda existem como diretorio/arquivo real.
    # Rodada 2 (2026-08-18): a regra so cobria o caminho "nu" (^checkout-v2/?$),
    # e nem esse na pratica, porque o redirect de diretorio do Apache resolvia
    # antes (por isso o 301 observado). checkout-v2/index.php continuava
    # servivel com 200 -- uma pagina de checkout de 1000+ linhas, publica, sem
    # noindex, cujo botao de finalizar pedido sempre falhava com 403 (posta em
    # api/orders/create-v2.php, que ja esta bloqueado). Agora cobre o diretorio
    # inteiro, no mesmo padrao ja usado em ^api/autonomous/.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^checkout-v2/?$ /checkout [R=301,L,NE,QSD]
    RewriteRule ^checkout-v2(?:/.*)?$ - [F,L,NC]
    RewriteRule ^api/orders/create-v2\.php$ - [F,L,NC]

    RewriteRule ^p/termos-e-condicoes/?$ /termos [R=301,L,NE,QSD]

    # Consolidacao do admin: entradas sem barra e index.php apontam para /admin/.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^admin$ /admin/ [R=301,L,NE,QSD,NC]
    # Redirecionar index.php apenas quando ele foi solicitado explicitamente pelo cliente.
    # DirectoryIndex resolve /admin/ internamente para admin/index.php; redirecionar essa
    # sub-requisicao de volta para /admin/ causa um loop infinito de 301.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+admin/index\.php(?:[?\s]) [NC]
    RewriteRule ^admin/index\.php$ /admin/ [R=301,L,NE,QSD,NC]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^admin/(?:menu-completo|menu-dashboard|dashboard|admin-back)\.php$ /admin/ [R=301,L,NE,QSD,NC]
    RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$ [NC]
    RewriteRule ^admin/(?:menu-completo|menu-dashboard|dashboard|admin-back)\.php$ - [F,L,NC]

    # URLs publicas remanescentes da vitrine anterior vao para o catalogo atual.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteRule ^(?:ferramentas|arte-papelaria-e-armarinho|produtos)(?:/.*)?$ /catalogo [R=301,L,NE,QSD,NC]

    # Nunca expor arquivos internos de configuracao e operacao
    RewriteRule ^config/ - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^(?:criar-pagamento-teste-real|criar-pagamento-producao|gerar-payment-id-agora|fazer-pagamento-real-agora|simular-pagamento-real)\.php$ - [F,L,NC]
    RewriteRule ^logs/ - [F,L]
    RewriteRule ^(?:\.git|\.env(?:\.|$)|\.claude|\.codex|\.github|\.githooks|\.vscode|\.tmp_shopvivaliz|__pycache__|scripts|tests|test-results|deploy|docs|reports|scratch|automation|automations|autodev|core|dashboards|imports|kong|listings|medusa|migrations|planilhas|public_html|release-notes|tools|utils|CheckoutPageOptimizer|installer)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:api/sandbox/|admin/(?:mercadopago-sandbox\.php|webhook-test\.php|test-auto-sync\.sh)|olist/produtos-198\.php|claude/api/get-produtos-198\.php)$ - [F,L,NC]
    RewriteRule ^(?:debug|test|teste|check|gen-token)(?:[-_.][^/]*)?$ - [F,L,NC]
    RewriteRule ^(?:setup-webhooks|update-fallback-prices)\.php$ - [F,L,NC]
    # Rodada 2 (2026-08-18): deploy-webhook.php ja foi neutralizado (410) no
    # codigo, mas esta regra cobre a copia que ainda esta no release imutavel
    # em producao ate o proximo deploy trocar o symlink `current`. Ver o
    # relatorio da Rodada 2 pro raciocinio completo (git pull via exec() com
    # GITHUB_TOKEN embutido na URL, ou copia arquivo-por-arquivo por cima do
    # webroot, se DEPLOY_SECRET for configurado um dia).
    RewriteRule ^deploy-webhook\.php$ - [F,L,NC]
    # api/coupons/validate.php: endpoint legado sem rate limit que resolvia
    # cupons hardcoded no codigo (FRETEGRATIS, PRIMEIRA10 etc) que nao existem
    # no banco -- prometia desconto na UI mas o motor oficial (svcp_validate,
    # usado em orders/create-validated.php) recusava no checkout de verdade.
    # Nenhum consumidor interno usa este endpoint (so api/coupons/active.php
    # e consumido, por includes/popup-cupons.php). Ver B3 no relatorio da
    # Rodada 2.
    RewriteRule ^api/coupons/validate\.php$ - [F,L,NC]
    RewriteRule ^sync(?:[-a-z0-9]*)?\.php$ - [F,L,NC]
    RewriteRule ^(?:discover-db|do-sync-[a-z0-9-]+|find-db-host|fix-database|full-sync|get_ext_dir|get_php_info|shop-catalog-export)\.php$ - [F,L,NC]
    RewriteRule ^C.*shopee-sync\.php$ - [F,L,NC]
    RewriteRule ^api/(?:catalog/test-normalize\.php|(?:pagarme|melhorenvio|olist)/diagnostic(?:-full)?\.php|sync-cache-endpoint\.php|sync/full-sync\.php)$ - [F,L,NC]

    # SEGURANCA: dumps internos do catalogo carregam avg_cost_price (custo
    # medio) e a lista de fornecedores. Nunca podem ser servidos ao publico —
    # a vitrine le esses arquivos pelo filesystem (PHP), nao por HTTP.
    RewriteRule ^api/catalog/fallback-products\.json - [F,L,NC]
    RewriteRule ^api/catalog/fallback-products\.json\.backup - [F,L,NC]
    RewriteRule ^uploads/olist_imagens_site_mapeamento\.csv$ - [F,L,NC]
    RewriteRule \.(?:bak|backup|old|orig|sql|sqlite|log|ini)$ - [F,L,NC]

    # SEGURANCA: api/autonomous/ e maquinaria interna dos agentes (exec() de
    # ps/df/free/mysqldump, gestao de incidentes). Nada no site consome esses
    # arquivos por HTTP -- so a CLI, via scripts/autonomous-orchestrator-loop.sh.
    # Hoje respondem 200 (corpo vazio, sao apenas classes); negar a rota remove
    # a superficie antes que algum arquivo passe a executar no include.
    RewriteRule ^api/autonomous/ - [F,L,NC]

    # SEGURANCA: classes e arquivos de configuracao dos modulos de IA do admin
    # sao apenas includes (definem constantes com nomes de chaves de API).
    # Nao ha motivo para serem alcancaveis por HTTP.
    RewriteRule ^admin/(?:catalog-optimization|ai-image-studio)/(?:src/|config) - [F,L,NC]

    # Aliases operacionais canonicos para SRE/monitoramento externo.
    RewriteRule ^health/?$ health.php [L,QSA]
    RewriteRule ^metrics/?$ metrics.php [L,QSA]
    RewriteRule ^erp/health/?$ erp/health.php [L,QSA]

    # Valida preco, estoque, cupom e frete no servidor antes de criar o pedido.
    RewriteRule ^api/orders/create\.php$ api/orders/create-validated.php [L]

    # Case-insensitive routing para /admin.
    RewriteCond %{REQUEST_URI} ^/[aA][dD][mM][iI][nN](?:/|$) [NC]
    RewriteCond %{REQUEST_URI} !^/admin(?:/|$) [NC]
    RewriteRule ^(.*)$ /admin/$1 [R=301,L,NE]

    RewriteRule ^claude/?$ claude/index.php [L]
    RewriteRule ^claude/(.*)$ claude/$1 [L]

    # Normaliza URLs legadas para as rotas canonicas.
    RewriteCond %{THE_REQUEST} \s/carrinho\.php[\s?]
    RewriteRule ^carrinho\.php$ /carrinho [R=301,L]
    RewriteCond %{THE_REQUEST} \s/checkout\.php[\s?]
    RewriteRule ^checkout\.php$ /checkout [R=301,L]

    # Compatibilidade de landing pages legadas usadas em campanhas Google Ads.
    # Resolve diretamente pelos IDs atuais do catalogo, preservando query strings
    # de tracking e sem alterar preco, estoque ou cadastro dos produtos.
    RewriteRule ^produto/vaso-antique-55-75l-macchiato-japi-brown/?$ produto.php?id=341533994 [L,QSA,NC]
    RewriteRule ^produto/vaso-decor-plantas-cilin-decore-34-28l-aco-corten-japi-168/?$ produto.php?id=350509721 [L,QSA,NC]

    # Nao reescrever arquivos e diretorios reais
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo slug de produto passa por um guard de canonicalizacao. O PHP so
    # redireciona aliases quando consegue provar slug historico -> SKU -> item
    # ativo no catalogo atual; caso contrario preserva o 404 normal.
    RewriteRule ^produto/([^/]+)/?$ produto-slug-route.php?slug=$1 [L,QSA]

    # Cart API endpoints
    RewriteRule ^api/cart/add/?$ api/cart/add.php [L,QSA]
    RewriteRule ^api/cart/get/?$ api/cart/get.php [L,QSA]
    RewriteRule ^api/cart/remove/?$ api/cart/remove.php [L,QSA]
    RewriteRule ^api/cart/clear/?$ api/cart/clear.php [L,QSA]
    RewriteRule ^api/cart/validate/?$ api/cart/validate.php [L,QSA]
    RewriteRule ^api/cart/sync/?$ api/cart/sync.php [L,QSA]

    # Mercado Livre OAuth
    RewriteRule ^api/ml/login/?$ api/ml/login.php [L]
    RewriteRule ^api/ml/callback/?$ api/ml/callback.php [L,QSA]
    RewriteRule ^api/ml/token/status/?$ api/ml/token.php [L]
    RewriteRule ^api/ml/token/refresh/?$ api/ml/token.php [L]
    RewriteRule ^api/ml/me/?$ api/ml/me.php [L]
    RewriteRule ^api/ml/webhook/?$ api/ml/webhook.php [L,QSA]
    RewriteRule ^api/ml/products/?$ api/ml/products.php [L,QSA]
    RewriteRule ^api/ml/optimizer/?$ api/ml/optimizer.php [L,QSA]
    RewriteRule ^api/maintenance/opcache-reset/?$ api/maintenance/opcache-reset.php [L,QSA]
    RewriteRule ^admin/mercadolivre/?$ admin/mercadolivre.php [L]

    # Catalog API endpoints
    RewriteRule ^api/products/latest/?$ api/catalog/products.php [L,QSA]
    RewriteRule ^api/products/?$ api/catalog/products.php [L,QSA]
    RewriteRule ^api/catalog/?$ api/catalog/products.php [L,QSA]
    RewriteRule ^api/knowledge/search/?$ api/knowledge-search.php [L,QSA]
    RewriteRule ^api/liz/knowledge-preview/?$ api/liz-knowledge-preview.php [L,QSA]
    RewriteRule ^api/liz/intelligent-knowledge/?$ api/liz-intelligent-knowledge.php [L,QSA]

    # Rotas principais da loja
    RewriteRule ^$ index.php [L]
    RewriteRule ^produtos/?$ catalogo.php [L]
    RewriteRule ^catalogo/?$ catalogo.php [L]
    RewriteRule ^carrinho/?$ carrinho.php [L]
    RewriteRule ^checkout/?$ checkout.php [L]
    RewriteRule ^checkout/retorno/?$ checkout-return.php [L,QSA]
    RewriteRule ^sobre/?$ sobre/index.php [L]
    RewriteRule ^contato/?$ contato/index.php [L]
    RewriteRule ^faq/?$ faq/index.php [L]
    RewriteRule ^blog/feed\.xml$ blog/feed.php [L]
    RewriteRule ^blog/?$ blog/index.php [L]
    RewriteRule ^blog/([a-z0-9][a-z0-9-]*)/?$ blog/artigo.php?slug=$1 [L,QSA]
    RewriteRule ^google-ads-api-app/?$ google-ads-api-app.php [L]
    RewriteRule ^feed-google-merchant\.xml$ google-merchant-feed.php [L]
    RewriteRule ^termos/?$ termos.php [L]
    RewriteRule ^p/termos/?$ termos.php [L]
    RewriteRule ^p/politica-privacidade/?$ politica-privacidade/index.php [L]
    RewriteRule ^politica-privacidade/?$ politica-privacidade/index.php [L]
    RewriteRule ^politica-devolucoes/?$ politica-devolucoes.php [L]
    RewriteRule ^politica-entrega/?$ politica-entrega.php [L]
    RewriteRule ^produto/?$ produto.php [L]
    RewriteRule ^produto/([^/]+)/?$ produto.php?slug=$1 [L,QSA]
    RewriteRule ^newsletter/confirmar/?$ api/newsletter/confirm.php [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
</IfModule>
