{
  "package": "shopvivaliz-production-agents",
  "version": "11.2.0-scheduled-evidence-agents",
  "updated_at": "2026-08-18",
  "trigger_mode": "scheduled",
  "schedule_minutes": 60,
  "workflow": ".github/workflows/autonomous-watchdog.yml",
  "execution_path": "/home/ubuntu/shopvivaliz-deploy/current",
  "runtime_endpoint": "/api/agent/real-work-orchestrator.php",
  "evidence_file": "storage/agent-evidence/latest-agent-cycle.json",
  "agents": [
    {
      "id": "operational_work",
      "class": "ShopvivalizRealWorkOrchestratorAgent",
      "mode": "mutating"
    },
    {
      "id": "catalog_metadata",
      "class": "ShopvivalizCatalogMetadataAgent",
      "mode": "mutating"
    },
    {
      "id": "conversion_funnel",
      "class": "ShopvivalizConversionFunnelAgent",
      "mode": "observability"
    },
    {
      "id": "media_quality",
      "class": "ShopvivalizMediaQualityAgent",
      "mode": "observability"
    },
    {
      "id": "media_mismatch",
      "class": "ShopvivalizMediaMismatchAgent",
      "mode": "observability"
    }
  ],
  "requirements": {
    "execution_accepted": true,
    "minimum_work_evidence_count": 12,
    "forbidden_statuses": [
      "queued",
      "degraded",
      "simulated",
      "mock",
      "dry_run",
      "dry-run"
    ],
    "no_hardcoded_secrets": true
  }
}
