{
    "name": "vivaliz/site-shopvivaliz",
    "description": "E-commerce ShopVivaliz com integração Mercado Pago",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "mercadopago/dx-php": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "ShopVivaliz\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "echo 'Mercado Pago SDK instalado com sucesso!'"
        ]
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        }
    }
}
