[Unit]
Description=ShopVivaliz Mobile Agent Bridge
Documentation=file:/home/ubuntu/site-shopvivaliz/agent-bridge/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/site-shopvivaliz
ExecStart=/usr/bin/python3 /home/ubuntu/site-shopvivaliz/agent-bridge/agent_bridge.py --config /home/ubuntu/site-shopvivaliz/agent-bridge/config.json --sleep 30
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
