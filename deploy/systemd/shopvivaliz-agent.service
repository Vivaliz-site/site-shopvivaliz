[Unit]
Description=ShopVivaliz verified production-agent loop
Documentation=file:/home/ubuntu/shopvivaliz-deploy/current/AGENTS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
Environment=SHOPVIVALIZ_PROJECT_DIR=/home/ubuntu/shopvivaliz-deploy/current
Environment=SHOPVIVALIZ_AGENT_INTERVAL_SECONDS=900
ExecStart=/bin/bash /home/ubuntu/shopvivaliz-deploy/current/scripts/autonomous-agent-loop.sh
Restart=on-failure
RestartSec=120
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/home/ubuntu/shopvivaliz-deploy/current/logs /home/ubuntu/shopvivaliz-deploy/current/storage/agent-evidence

[Install]
WantedBy=multi-user.target
