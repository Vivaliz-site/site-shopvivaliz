[Unit]
Description=ShopVivaliz Olist/Tiny Catalog Reconciliation
After=network-online.target shopvivaliz-token-renewer.service
Wants=network-online.target shopvivaliz-token-renewer.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/shopvivaliz-deploy/current/daemon-sync-products.py --once --workers 4
TimeoutStartSec=20min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
