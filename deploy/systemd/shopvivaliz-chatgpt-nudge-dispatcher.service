[Unit]
Description=ShopVivaliz ChatGPT continuity nudge fast lane
Documentation=file:/opt/shopvivaliz-gemini-24x7-controller/README
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/shopvivaliz-gemini-24x7-controller.env
WorkingDirectory=/opt/shopvivaliz-gemini-24x7-controller
ExecStart=/usr/bin/python3 ${SHOPVIVALIZ_CHATGPT_NUDGE_ENTRY} --runtime-dir ${SHOPVIVALIZ_AGENT_TASK_STATE_DIR}
TimeoutStartSec=55
NoNewPrivileges=true
PrivateTmp=true
