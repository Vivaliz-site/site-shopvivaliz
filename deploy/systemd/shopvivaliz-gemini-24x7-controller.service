[Unit]
Description=ShopVivaliz Gemini 24x7 task-continuity controller
Documentation=file:/opt/shopvivaliz-gemini-24x7-controller/README
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/shopvivaliz-gemini-24x7-controller.env
WorkingDirectory=/opt/shopvivaliz-gemini-24x7-controller
ExecStart=/usr/bin/python3 ${SHOPVIVALIZ_GEMINI_CONTROLLER_ENTRY} --daemon --interval-seconds 30
Restart=always
RestartSec=60
CPUWeight=900
IOWeight=900
KillMode=control-group
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
