[Unit]
Description=ShopVivaliz Hourly Autonomous Guardian
After=network-online.target shopvivaliz-agent.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
ExecStart=/usr/bin/python3 /home/ubuntu/shopvivaliz-deploy/current/scripts/autonomous-hourly-guardian.py

