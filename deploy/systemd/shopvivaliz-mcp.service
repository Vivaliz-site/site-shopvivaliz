[Unit]
Description=ShopVivaliz MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
EnvironmentFile=/home/ubuntu/shopvivaliz-deploy/shared/.env
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=5556
ExecStart=/usr/bin/python3 /home/ubuntu/shopvivaliz-deploy/current/scripts/mcp-server.py --host 127.0.0.1 --port 5556 --env ubuntu-vm
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
