[Unit]
Description=ShopVivaliz Payment/Async Queue Worker
Documentation=file:/home/ubuntu/shopvivaliz-deploy/current/scripts/queue-worker.php
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
# Rodada 9 (2026-08-19): User/Group = www-data (NAO ubuntu) -- descoberto na
# validacao ao vivo: todo arquivo em storage/orders/*.json e storage/*.sqlite
# e criado pelo Apache/PHP-FPM como www-data:www-data, modo 644 (sem write
# de grupo). Rodando como "ubuntu" (mesmo sendo membro do grupo www-data), o
# worker conseguia LER os pedidos mas falhava com "Permission denied" ao
# tentar reabrir em r+ pra gravar o status apos o webhook -- silencioso ate
# a primeira tentativa real de escrita. www-data como dono resolve de raiz,
# sem depender de chmod retroativo em arquivos novos.
User=www-data
Group=www-data
# Rodada 9 (2026-08-19): WorkingDirectory precisa ser o symlink "current" --
# NAO /home/ubuntu/site-shopvivaliz. "current" -> releases/<ts>-<sha>, e
# "current/storage" -> ../../shared/storage (ver .htaccess/README de deploy),
# que e o MESMO storage/queue.sqlite que os webhooks HTTP escrevem (Apache
# serve de shopvivaliz-deploy/current). Rodar a partir do outro diretorio
# abriria uma fila SQLite diferente e processaria zero jobs pra sempre --
# silenciosamente. Ver R9-1 no relatorio da Rodada 9 e docs/AGENTS.md.
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
ExecStart=/usr/bin/php /home/ubuntu/shopvivaliz-deploy/current/scripts/queue-worker.php --limit=5 --sleep=5
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
