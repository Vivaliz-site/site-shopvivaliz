[Unit]
Description=ShopVivaliz Shopee Logistics Watchdog
After=network-online.target shopvivaliz-shopee-logistics-worker.timer
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
EnvironmentFile=/home/ubuntu/shopvivaliz-deploy/shared/.env
Environment=PYTHONUNBUFFERED=1
Environment=SHOPEE_LOGISTICS_STALE_AFTER_SECONDS=540
ExecStart=/usr/bin/python3 /home/ubuntu/shopvivaliz-deploy/current/scripts/shopee_logistics_watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/shopvivaliz-deploy/shared /etc/systemd/system
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
