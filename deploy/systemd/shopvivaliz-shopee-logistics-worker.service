[Unit]
Description=ShopVivaliz Shopee Logistics Auto-Ship Worker
After=network-online.target shopvivaliz-shopee-token-renewer.service
Wants=network-online.target shopvivaliz-shopee-token-renewer.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
EnvironmentFile=/home/ubuntu/shopvivaliz-deploy/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/shopvivaliz-deploy/current/scripts/shopee_logistics_worker.py --apply
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/shopvivaliz-deploy/shared
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
