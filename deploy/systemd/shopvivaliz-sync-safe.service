[Unit]
Description=ShopVivaliz Safe Repository Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/repo
ExecStart=/bin/bash /usr/local/lib/shopvivaliz/safe-repo-sync.sh
# Intentional exception: safe-repo-sync may hand off a protected-main update
# to deploy-production.sh, which requires sudo for systemd/Apache reconciliation.
NoNewPrivileges=false
PrivateTmp=true
StandardOutput=journal
StandardError=journal
