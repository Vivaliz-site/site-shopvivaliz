[Unit]
Description=ShopVivaliz Olist OAuth Proactive Token Renewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/shopvivaliz-deploy/current
Environment=PYTHONUNBUFFERED=1
Environment=SHOPVIVALIZ_OLIST_TOKEN_FILE=/home/ubuntu/shopvivaliz-deploy/shared/private/olist-tokens.json
ExecStart=/usr/bin/python3 /home/ubuntu/shopvivaliz-deploy/current/daemon-token-renewer.py --interval 300 --retry-interval 300 --refresh-margin 1800
Restart=always
RestartSec=30
TimeoutStopSec=30
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ExecStartPre=/usr/bin/install -d -o ubuntu -g www-data -m 2770 /home/ubuntu/shopvivaliz-deploy/shared/private
ExecStartPre=/usr/bin/touch /home/ubuntu/shopvivaliz-deploy/shared/private/olist-token-rotation.lock
ExecStartPre=/usr/bin/chown ubuntu:www-data /home/ubuntu/shopvivaliz-deploy/shared/private/olist-token-rotation.lock
ExecStartPre=/usr/bin/chmod 0660 /home/ubuntu/shopvivaliz-deploy/shared/private/olist-token-rotation.lock
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
