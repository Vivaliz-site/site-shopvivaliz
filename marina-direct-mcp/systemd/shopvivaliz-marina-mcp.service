# STAGING TEMPLATE ONLY. Official host administrator review/install required.
# Never install or execute through GitHub Actions or an unapproved RDC privilege route.
[Unit]
Description=ShopVivaliz Marina independent MCP (grant-scoped admin shell, GUI and browser)
After=network.target
ConditionPathExists=/var/lib/shopvivaliz-marina-mcp/.config/shopvivaliz-marina-mcp/auth-token

[Service]
Type=exec
User=shopvivaliz-marina-mcp
Group=shopvivaliz-marina-mcp
WorkingDirectory=/opt/shopvivaliz-marina-mcp/current
ExecStart=/usr/bin/python3 /opt/shopvivaliz-marina-mcp/current/server.py --port 5580 --token-file /var/lib/shopvivaliz-marina-mcp/.config/shopvivaliz-marina-mcp/auth-token --enable-approved-scoped-write --enable-approved-admin-broker --enable-admin-shell --enable-gui-browser --access-config /var/lib/shopvivaliz-marina-mcp/.config/shopvivaliz-marina-mcp/cloudflare-access.json
Restart=on-failure
RestartSec=5s
UMask=0077
# No privilege or sandbox restrictions are set here: the admin shell runs commands
# as root through sudo. The HTTP process itself runs as the unprivileged account.
PrivateTmp=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
