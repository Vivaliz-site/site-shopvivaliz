# INSTALL ONLY after official owner grant + root-owned protected credential.
# Deliberately root-only broker over systemd AF_UNIX socket; no network.
[Unit]
Description=ShopVivaliz Marina scoped root broker (owner PR gated)
Requires=shopvivaliz-marina-root-broker.socket
After=shopvivaliz-marina-root-broker.socket

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/python3 -B /opt/shopvivaliz-marina-mcp/current/root_broker.py
StateDirectory=shopvivaliz-marina-broker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=no
PrivateDevices=no
PrivateTmp=no
ProtectSystem=strict
ProtectHome=no
ProtectKernelModules=no
ProtectKernelTunables=no
ProtectControlGroups=no
LockPersonality=no
# Outbound HTTPS is required for fresh GitHub grant verification.
# The only inbound listener is the inherited, validated AF_UNIX socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=24
TimeoutStartSec=15
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
