#!/bin/sh
set -eu
LOG=/var/log/shopvivaliz-disk-guard.log
STATE_DIR=/var/lib/shopvivaliz-ops
STATE="$STATE_DIR/disk-status.env"
mkdir -p "$STATE_DIR"

pct() {
  df -P / | awk 'NR==2 {gsub("%","",$5); print $5}'
}
inode_pct() {
  df -Pi / | awk 'NR==2 {gsub("%","",$5); print $5}'
}
classify() {
  value="$1"
  if [ "$value" -ge 90 ]; then echo critical
  elif [ "$value" -ge 80 ]; then echo warning
  elif [ "$value" -ge 70 ]; then echo observe
  else echo ok
  fi
}

before=$(pct)
inode_before=$(inode_pct)
now=$(date -u +%FT%TZ)
level=$(classify "$before")
inode_level=$(classify "$inode_before")
printf '%s root_before=%s%% level=%s inode_before=%s%% inode_level=%s\n' "$now" "$before" "$level" "$inode_before" "$inode_level" >> "$LOG"

# Close the feedback loop early: once root reaches 70%, run the guarded
# workspace lifecycle cleanup. It only removes inactive, clean, delivered
# worktrees and known regenerable temp/cache artifacts.
if [ "$before" -ge 70 ] && [ -x /usr/local/sbin/shopvivaliz-workspace-housekeeper ]; then
  /usr/local/sbin/shopvivaliz-workspace-housekeeper >/dev/null 2>&1 || true
  before="$(pct)"
fi

cleanup_regenerable_node_cache() {
  home=/home/ubuntu
  if command -v npm >/dev/null 2>&1 && [ -d "$home/.npm" ]; then
    sudo -u ubuntu npm cache clean --force >/dev/null 2>&1 || true
  fi
  base="$home/.npm/_npx"
  [ -d "$base" ] || return 0
  for d in "$base"/*; do
    [ -d "$d" ] || continue
    find "$d" -maxdepth 0 -mtime +1 | grep -q . || continue
    in_use=0
    for c in /proc/[0-9]*/cmdline; do
      [ -r "$c" ] || continue
      if tr '\0' ' ' < "$c" 2>/dev/null | grep -Fq -- "$d"; then
        in_use=1
        break
      fi
    done
    [ "$in_use" -eq 0 ] || continue
    rm -rf --one-file-system "$d"
  done
}

# Safe, bounded cleanup only. Never truncate Docker json-file logs in place.
# Start with regenerable agent caches in observe state so disk does not drift into warning.
if [ "$before" -ge 75 ]; then
  cleanup_regenerable_node_cache
fi
if [ "$before" -ge 80 ]; then
  journalctl --vacuum-size=512M >/dev/null 2>&1 || true
  apt-get clean >/dev/null 2>&1 || true
  docker image prune -af --filter until=168h >/dev/null 2>&1 || true
  docker builder prune -af --filter until=168h >/dev/null 2>&1 || true
fi
if [ "$before" -ge 90 ]; then
  journalctl --vacuum-size=256M >/dev/null 2>&1 || true
fi

after=$(pct)
inode_after=$(inode_pct)
level=$(classify "$after")
inode_level=$(classify "$inode_after")
docker_state=$(systemctl is-active docker 2>/dev/null || true)
zram_state=$(systemctl is-active shopvivaliz-zram.service 2>/dev/null || true)
load1=$(awk '{print $1}' /proc/loadavg)

cat > "$STATE" <<EOF2
timestamp=$(date -u +%FT%TZ)
root_pct=$after
level=$level
inode_pct=$inode_after
inode_level=$inode_level
docker_active=$docker_state
zram_active=$zram_state
load1=$load1
EOF2

printf '%s root_after=%s%% level=%s inode_after=%s%% inode_level=%s docker=%s zram=%s load1=%s\n' "$(date -u +%FT%TZ)" "$after" "$level" "$inode_after" "$inode_level" "$docker_state" "$zram_state" "$load1" >> "$LOG"

if [ "$after" -ge 90 ]; then
  logger -p daemon.crit -t shopvivaliz-disk-guard "root filesystem critical: $after%"
elif [ "$after" -ge 80 ]; then
  logger -p daemon.warning -t shopvivaliz-disk-guard "root filesystem warning: $after%"
fi
if [ "$inode_after" -ge 90 ]; then
  logger -p daemon.crit -t shopvivaliz-disk-guard "root inode usage critical: $inode_after%"
elif [ "$inode_after" -ge 80 ]; then
  logger -p daemon.warning -t shopvivaliz-disk-guard "root inode usage warning: $inode_after%"
fi
if [ "$docker_state" != active ]; then
  logger -p daemon.crit -t shopvivaliz-disk-guard "docker service state: $docker_state"
fi
if [ "$zram_state" != active ]; then
  logger -p daemon.warning -t shopvivaliz-disk-guard "zram service state: $zram_state"
fi
