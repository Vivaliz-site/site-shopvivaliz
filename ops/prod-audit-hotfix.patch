+    curl_close($ch);
+    $data = is_string($body) ? json_decode($body, true) : null;
+    return [
+        'ok' => $status >= 200 && $status < 300,
+        'status' => $status,
+        'error' => $error !== '' ? $error : null,
+        'data' => is_array($data) ? $data : null,
+        'raw' => is_string($body) ? substr($body, 0, 500) : null,
