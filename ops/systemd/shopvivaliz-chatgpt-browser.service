[Unit]
Description=ShopVivaliz canonical authenticated ChatGPT browser
After=network-online.target display-manager.service
Wants=network-online.target display-manager.service

[Service]
Type=simple
CPUWeight=700
IOWeight=700
User=fredrdp
Group=fredrdp
Environment=HOME=/home/fredrdp
Environment=DISPLAY=:99
Environment=XAUTHORITY=/home/fredrdp/.Xauthority
# The canonical browser runs outside a desktop user session. Give Chrome an
# isolated session bus that lives exactly as long as the browser service.
ExecStartPre=/usr/bin/test -S /tmp/.X11-unix/X99
ExecStartPre=/usr/bin/test -x /usr/bin/dbus-run-session
ExecStart=/usr/bin/dbus-run-session -- /opt/shopvivaliz-browser/chrome-linux/chrome --user-data-dir=/home/fredrdp/.config/shopvivaliz-chromium --remote-debugging-address=127.0.0.1 --remote-debugging-port=9555 --no-sandbox --no-first-run --no-default-browser-check --disable-dev-shm-usage --disable-gpu https://chatgpt.com/
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
BindReadOnlyPaths=/tmp/.X11-unix

[Install]
WantedBy=multi-user.target
