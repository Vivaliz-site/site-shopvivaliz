[Unit]
Description=ShopVivaliz Desktop Commander four-host sentinel
After=network-online.target shopvivaliz-desktop-commander.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/shopvivaliz/desktop-commander-four-host-sentinel.sh
StateDirectory=shopvivaliz-dc-four-host-sentinel
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
