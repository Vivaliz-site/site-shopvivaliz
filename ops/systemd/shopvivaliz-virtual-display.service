[Unit]
Description=ShopVivaliz persistent authenticated X11 display :99 for isolated ChatGPT browsers
After=local-fs.target
Before=shopvivaliz-dev-browser.service shopvivaliz-atendimento-browser.service shopvivaliz-chatgpt-browser.service

[Service]
Type=exec
User=fredrdp
Group=fredrdp
Environment=HOME=/home/fredrdp
Environment=DISPLAY=:99
Environment=XAUTHORITY=/home/fredrdp/.Xauthority
UMask=0077
ExecStartPre=/usr/local/libexec/shopvivaliz-virtual-display-guard.sh prepare
ExecStart=/usr/bin/Xvfb :99 -screen 0 1600x900x24 -nolisten tcp -auth /home/fredrdp/.Xauthority
ExecStartPost=/usr/local/libexec/shopvivaliz-virtual-display-guard.sh wait
Restart=always
RestartSec=5
TimeoutStartSec=25
KillMode=control-group
TasksMax=128
MemoryHigh=384M
MemoryMax=640M
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=false

[Install]
WantedBy=multi-user.target
