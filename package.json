{
  "name": "shopvivaliz",
  "private": true,
  "scripts": {
    "audit:tree": "python scripts/audit-static-tree.py --dry-run",
    "audit:tree:json": "python scripts/audit-static-tree.py --dry-run --json",
    "audit:tree:quarantine": "python scripts/audit-static-tree.py --delete",
    "build:assets": "node scripts/build-assets.mjs",
    "assets:validate": "php scripts/quality/validate-asset-manifest.php",
    "health:check": "php scripts/quality/validate-health-output.php",
    "dev:queue": "php -S 127.0.0.1:8088 -t .",
    "worker": "php scripts/queue-worker.php",
    "queue:smoke": "php scripts/queue-smoke.php",
    "qa:browser": "node scripts/browser-qa-validate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright": "^1.61.1"
  }
}
