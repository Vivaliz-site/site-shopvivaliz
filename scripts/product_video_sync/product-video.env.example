# Configuracao nao secreta da Etapa 1.
# Credenciais OAuth sao reutilizadas do runtime existente do site.

PRODUCT_VIDEO_BASE_URL=https://shopvivaliz.com.br/uploads/videos-produtos/
# Em producao, o default ja resolve para <release>/uploads/videos-produtos.
# PRODUCT_VIDEO_DIR=/home/ubuntu/shopvivaliz-deploy/current/uploads/videos-produtos
PRODUCT_VIDEO_HTTP_TIMEOUT=20
PRODUCT_VIDEO_MAX_RETRIES=3
PRODUCT_VIDEO_PAGE_SIZE=100

# Ultimo recurso. Deixe desligado enquanto API + inventario do servidor forem suficientes.
PRODUCT_VIDEO_ALLOW_PLAYWRIGHT=0

# Opcional: JSON {"SKU-ou-ID": "arquivo.mp4"}
# PRODUCT_VIDEO_ALIAS_FILE=/caminho/aliases.json

# O token e lido preferencialmente do store rotativo ja existente:
# SHOPVIVALIZ_OLIST_TOKEN_FILE=/home/ubuntu/shopvivaliz-deploy/shared/private/olist-tokens.json
