[Unit]
Description=ShopVivaliz OKX ChatGPT browser decision bridge
After=network-online.target shopvivaliz-browser-dev-mcp.service
Wants=network-online.target shopvivaliz-browser-dev-mcp.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/shopvivaliz-okx-paper/current
Environment=OKX_CHATGPT_DEV_MCP_URL=http://127.0.0.1:5583/mcp
Environment=OKX_CHATGPT_DEV_MCP_HEALTH_URL=http://127.0.0.1:5583/health
Environment=OKX_CHATGPT_BROWSER_BRIDGE_PORT=17657
EnvironmentFile=/var/lib/shopvivaliz-remote-control/service.env
ExecStart=/usr/bin/node scripts/chatgpt-browser-bridge.mjs
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
