[Unit]
Description=ShopVivaliz OKX PAPER-only continuous simulator
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
StateDirectory=shopvivaliz-okx-paper
StateDirectoryMode=0700
WorkingDirectory=/opt/shopvivaliz-okx-paper/current
Environment=PYTHONPATH=/opt/shopvivaliz-okx-paper/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/shopvivaliz-okx-paper/venv/bin/python scripts/run.py --cycles 0 --interval 5 --audit /var/lib/shopvivaliz-okx-paper/paper-events-v3.jsonl --state /var/lib/shopvivaliz-okx-paper/paper-state-v3.json --status /var/lib/shopvivaliz-okx-paper/paper-status-v3.json
Restart=always
RestartSec=10
TimeoutStopSec=45
UMask=0077
Nice=10
CPUWeight=25
IOWeight=25
MemoryMax=384M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/shopvivaliz-okx-paper

[Install]
WantedBy=multi-user.target
